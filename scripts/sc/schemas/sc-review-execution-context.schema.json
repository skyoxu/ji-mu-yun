{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotgame.local/schemas/sc-review-execution-context.schema.json",
  "title": "sc-review execution-context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "run_id",
    "status",
    "failed_step"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "cmd": {
      "const": "sc-review-pipeline"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "requested_run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_type": {
      "type": "string",
      "enum": [
        "planned-only",
        "preflight-only",
        "llm-only",
        "deterministic-only",
        "full"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "reuse_mode": {
      "type": "string",
      "enum": [
        "none",
        "full-clean-reuse",
        "deterministic-only-reuse",
        "sc-test-reuse",
        "mixed-reuse"
      ]
    },
    "started_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "finished_at_utc": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "fail"
      ]
    },
    "failure_kind": {
      "type": "string",
      "enum": [
        "schema-invalid",
        "stale-latest",
        "artifact-missing",
        "artifact-incomplete",
        "aborted",
        "step-failed",
        "review-needs-fix",
        "ok"
      ]
    },
    "delivery_profile": {
      "type": "string",
      "minLength": 1
    },
    "security_profile": {
      "type": "string",
      "enum": [
        "strict",
        "host-safe"
      ]
    },
    "failed_step": {
      "type": "string"
    },
    "paths": {
      "type": "object"
    },
    "git": {
      "type": "object"
    },
    "recovery": {
      "type": "object"
    },
    "marathon": {
      "type": "object"
    },
    "agent_review": {
      "type": "object"
    },
    "recommended_action": {
      "type": "string"
    },
    "recommended_action_why": {
      "type": "string"
    },
    "candidate_commands": {
      "type": "object"
    },
    "recommended_command": {
      "type": "string"
    },
    "forbidden_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "latest_summary_signals": {
      "type": "object"
    },
    "chapter6_hints": {
      "type": "object"
    },
    "llm_review": {
      "type": "object"
    },
    "llm_review_metrics": {
      "$ref": "#/$defs/llmReviewMetrics"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    }
  },
  "$defs": {
    "digestOrSentinel": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64}|absent|not-applicable|unresolved)$"
    },
    "llmRuntimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "backend", "model", "reasoning_effort", "sandbox", "prompt_transport", "config_sha256", "backend_executable_sha256", "backend_version_sha256", "backend_adapter_sha256", "endpoint_sha256", "sdk_version", "complete", "error_codes"],
      "properties": {
        "schema_version": {"const": "sc-llm-review-runtime-identity.v1"},
        "backend": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string"},
        "sandbox": {"type": "string", "minLength": 1},
        "prompt_transport": {"type": "string", "minLength": 1},
        "config_sha256": {"$ref": "#/$defs/digestOrSentinel"},
        "backend_executable_sha256": {"$ref": "#/$defs/digestOrSentinel"},
        "backend_version_sha256": {"$ref": "#/$defs/digestOrSentinel"},
        "backend_adapter_sha256": {"$ref": "#/$defs/digestOrSentinel"},
        "endpoint_sha256": {"$ref": "#/$defs/digestOrSentinel"},
        "sdk_version": {"type": "string"},
        "complete": {"type": "boolean"},
        "error_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "llmReviewMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "requested_reviewer_count", "result_count", "status_counts", "llm_invocation_count", "llm_duration_sec_total", "prompt_chars_total", "prompt_chars_max", "prompt_chars_by_agent", "prompt_set_sha256", "prompt_truncated_count", "prompt_truncated_agents", "output_chars_total", "runtime", "input_identity_hash", "input_identity_complete", "pipeline_reuse_mode", "llm_result_reused"],
      "properties": {
        "schema_version": {"const": "sc-llm-review-metrics.v1"},
        "requested_reviewer_count": {"type": "integer", "minimum": 0},
        "result_count": {"type": "integer", "minimum": 0},
        "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "llm_invocation_count": {"type": "integer", "minimum": 0},
        "llm_duration_sec_total": {"type": "number", "minimum": 0},
        "prompt_chars_total": {"type": "integer", "minimum": 0},
        "prompt_chars_max": {"type": "integer", "minimum": 0},
        "prompt_chars_by_agent": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "prompt_set_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "prompt_truncated_count": {"type": "integer", "minimum": 0},
        "prompt_truncated_agents": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "output_chars_total": {"type": "integer", "minimum": 0},
        "runtime": {"$ref": "#/$defs/llmRuntimeIdentity"},
        "input_identity_hash": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
        "input_identity_complete": {"type": "boolean"},
        "pipeline_reuse_mode": {"enum": ["none", "full-clean-reuse", "deterministic-only-reuse", "sc-test-reuse", "mixed-reuse"]},
        "llm_result_reused": {"type": "boolean"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "soft_gate": {
          "type": "boolean"
        },
        "required_action": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "request_path": {
          "type": "string"
        },
        "response_path": {
          "type": "string"
        },
        "recommended_action": {
          "type": "string"
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_drift": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "previous_run_id": {
              "type": "string"
            },
            "previous_out_dir": {
              "type": "string"
            },
            "previous_delivery_profile": {
              "type": "string"
            },
            "previous_security_profile": {
              "type": "string"
            },
            "current_delivery_profile": {
              "type": "string"
            },
            "current_security_profile": {
              "type": "string"
            }
          }
        },
        "acceptance_preflight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "source_summary_file": {
              "type": "string"
            }
          }
        },
        "waste_signals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unit_failed_but_engine_lane_ran": {
              "type": "boolean"
            }
          }
        },
        "rerun_guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "blocked": {
              "type": "boolean"
            },
            "recommended_path": {
              "type": "string"
            },
            "override": {
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            }
          }
        },
        "reuse_decision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string"
            },
            "blocked": {
              "type": "boolean"
            }
          }
        },
        "llm_timeout_memory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "overrides": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            },
            "planned_agents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "change_scope_ceiling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "blocked": {
              "type": "boolean"
            },
            "recommended_path": {
              "type": "string"
            },
            "deterministic_strategy": {
              "type": "string"
            },
            "changed_paths_count": {
              "type": "integer"
            },
            "unsafe_paths_count": {
              "type": "integer"
            },
            "allow_override_flag": {
              "type": "string"
            },
            "changed_paths_sample": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unsafe_paths_sample": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "profile_drift_present": {
              "type": "boolean"
            },
            "ceilings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "changed_paths": {
                  "type": "integer"
                },
                "unsafe_paths": {
                  "type": "integer"
                },
                "profile_drift_changed_paths": {
                  "type": "integer"
                },
                "profile_drift_unsafe_paths": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "llm_retry_stop_loss": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blocked": {
              "type": "boolean"
            },
            "step_name": {
              "type": "string"
            },
            "timed_out_step": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "retry_count": {
              "type": "integer"
            },
            "deterministic_ok": {
              "type": "boolean"
            }
          }
        },
        "sc_test_retry_stop_loss": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blocked": {
              "type": "boolean"
            },
            "step_name": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "retry_count": {
              "type": "integer"
            },
            "deterministic_ok": {
              "type": "boolean"
            }
          }
        },
        "inherited_steps_invalidated": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "source_snapshot_sha256", "current_snapshot_sha256"],
          "properties": {
            "reason": {"const": "git_snapshot_changed"},
            "source_snapshot_sha256": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
            "current_snapshot_sha256": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"}
          }
        },
        "input_snapshot_drift": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "start_snapshot_sha256", "finish_snapshot_sha256"],
          "properties": {
            "reason": {"const": "git_snapshot_changed_during_run"},
            "start_snapshot_sha256": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"},
            "finish_snapshot_sha256": {"type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$"}
          }
        }
      }
    }
  }
}
