{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/workflow-model-shadow-execution-receipt.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "receiptId", "producerId", "routeId", "policyRevision",
    "cohortId", "predicateStatus", "representativeExecutionRefs", "observedAt",
    "authorizes"
  ],
  "properties": {
    "schemaVersion": {"const": "jimuyun.workflow-model-shadow-execution-receipt.v1"},
    "receiptId": {"type": "string", "minLength": 1},
    "producerId": {"const": "workflow-model-capability-evidence-producer.v1"},
    "routeId": {"type": "string", "minLength": 1},
    "policyRevision": {"type": "string", "minLength": 1},
    "cohortId": {"type": "string", "minLength": 1},
    "predicateStatus": {"const": "passed"},
    "representativeExecutionRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "observedAt": {"type": "string", "format": "date-time"},
    "authorizes": {"const": []}
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
