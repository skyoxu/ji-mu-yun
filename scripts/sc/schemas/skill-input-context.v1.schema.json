{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotgame.local/schemas/skill-input-context.v1.schema.json",
  "title": "Skill input context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_manifest_hash", "sections", "truncated", "omitted_items", "generated_at"],
  "properties": {
    "schema_version": {"const": "skill-input-context.v1"},
    "source_manifest_hash": {"$ref": "#/$defs/sha256"},
    "sections": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "content"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "truncated": {"type": "boolean"},
    "omitted_items": {"type": "integer", "minimum": 0},
    "generated_at": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
