{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotgame.local/schemas/skill-input-child-request.v1.schema.json",
  "title": "Skill input child request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "consumer", "operation", "contract_hash", "source_manifest_hash", "snapshot_root", "output_root", "execution_identity", "allowed_capabilities", "authorizes"],
  "properties": {
    "schema_version": {"const": "skill-input-child-request.v1"},
    "consumer": {"type": "string", "minLength": 1},
    "operation": {"enum": ["create", "repair", "review", "execute", "acceptance"]},
    "contract_hash": {"$ref": "#/$defs/sha256"},
    "source_manifest_hash": {"$ref": "#/$defs/sha256"},
    "snapshot_root": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)"},
    "output_root": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)"},
    "execution_identity": {"$ref": "#/$defs/sha256"},
    "allowed_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["read-frozen-snapshot", "write-context-output"]}
    },
    "authorizes": {"const": []}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
