{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "seeds", "baseline_status", "authorizes"],
  "properties": {
    "schema_version": {"const": "jimuyun.toolchain-evaluation-seed-manifest.v1"},
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["occurrence", "failure_family", "candidate_class", "provenance", "applicability", "missing_labels"],
        "properties": {
          "occurrence": {"type": "string", "minLength": 1},
          "failure_family": {"type": "string", "minLength": 1},
          "candidate_class": {"type": "string", "minLength": 1},
          "provenance": {"type": "object"},
          "applicability": {"type": "object"},
          "missing_labels": {"type": "array"},
          "counterexample": {"type": "object"},
          "explicit_absence": {"type": "object"}
        },
        "anyOf": [
          {"required": ["counterexample"]},
          {"required": ["explicit_absence"]}
        ],
        "additionalProperties": true
      }
    },
    "baseline_status": {"const": "non-authorizing-candidates"},
    "authorizes": {"const": []}
  },
  "additionalProperties": true
}
