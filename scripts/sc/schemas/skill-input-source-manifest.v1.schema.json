{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godotgame.local/schemas/skill-input-source-manifest.v1.schema.json",
  "title": "Skill input source manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_kind", "consumer", "operation", "sources", "created_at"],
  "properties": {
    "schema_version": {"const": "skill-input-source-manifest.v1"},
    "snapshot_kind": {"const": "model-safe"},
    "consumer": {"type": "string", "minLength": 1},
    "operation": {"enum": ["create", "repair", "review", "execute", "acceptance"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "semantic_snapshot_sha256", "sensitivity", "redaction_status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "semantic_snapshot_sha256": {"$ref": "#/$defs/sha256"},
          "sensitivity": {"enum": ["normal", "restricted", "credential-bearing"]},
          "redaction_status": {"enum": ["not-required", "complete", "failed"]}
        }
      }
    },
    "created_at": {"type": "string", "minLength": 1}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
