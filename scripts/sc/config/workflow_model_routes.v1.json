{
  "schemaVersion": "jimuyun.workflow-model-routing-policy.v1",
  "policyRevision": "workflow-model-routing.v2",
  "rolloutMode": "observe_only",
  "consumerControls": {
    "vdd": "enabled",
    "quick_dev": "enabled",
    "refactor_acceptance": "enabled"
  },
  "backend": "codex-cli",
  "sandbox": "workspace-write",
  "capabilityEvidencePolicy": {
    "producerId": "workflow-model-capability-evidence-producer.v1",
    "allowedEvidenceRoot": "logs/workflow-model-routing/capability-evidence",
    "probeReceiptSchemaVersion": "jimuyun.workflow-model-capability-probe-receipt.v1",
    "shadowReceiptSchemaVersion": "jimuyun.workflow-model-shadow-execution-receipt.v1"
  },
  "supportedEfforts": ["medium", "high", "xhigh", "max"],
  "models": {
    "sol": {
      "modelId": "gpt-6-sol",
      "displayLabel": "Sol",
      "activationState": "active"
    }
  },
  "routes": {
    "vdd.standard": {"consumer": "vdd", "model": "sol", "effort": "high", "launchMode": "child"},
    "vdd.resumable": {"consumer": "vdd", "model": "sol", "effort": "high", "launchMode": "child"},
    "vdd.self_hosted": {"consumer": "vdd", "model": "sol", "effort": "high", "launchMode": "child"},
    "vdd.complex_recovery": {
      "consumer": "vdd",
      "model": "sol",
      "effort": "high",
      "launchMode": "child",
      "activationState": "disabled_pending_evidence",
      "requiresCapabilityProbe": true,
      "requiresShadowPredicate": true,
      "capabilityEvidence": {
        "probeReceipt": null,
        "shadowReceipt": null
      }
    },
    "quick_dev.small_mechanical": {
      "consumer": "quick_dev",
      "model": "sol",
      "effort": "medium",
      "launchMode": "child"
    },
    "quick_dev.normal": {"consumer": "quick_dev", "model": "sol", "effort": "medium", "launchMode": "child"},
    "quick_dev.complex": {"consumer": "quick_dev", "model": "sol", "effort": "medium", "launchMode": "child"},
    "quick_dev.architectural": {"consumer": "quick_dev", "model": "sol", "effort": "medium", "launchMode": "child"},
    "refactor_acceptance.deterministic": {"consumer": "refactor_acceptance", "launchMode": "none"},
    "refactor_acceptance.complex_recovery": {
      "consumer": "refactor_acceptance",
      "model": "sol",
      "effort": "high",
      "launchMode": "child"
    },
    "bootstrap_review.external_profile": {
      "consumer": "bootstrap_review",
      "launchMode": "external_profile"
    }
  },
  "quickDevClassification": {
    "precedence": ["small_mechanical", "normal", "complex", "architectural"],
    "unknownFactDisposition": "complex_blocked",
    "overridePolicy": "upgrade_only"
  },
  "vddComplexRecoveryTriggers": [
    "bounded_repair_exhausted",
    "resume_state_recovery_failed",
    "validator_control_plane_inconsistent"
  ],
  "refactorAcceptanceComplexRecoveryTriggers": [
    "bootstrap_control_plane_unavailable",
    "candidate_binding_recovery_failed",
    "lineage_evidence_inconsistent"
  ],
  "authorizes": []
}
