{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["issuer", "promotion_id", "candidate_hash", "before_manifest_hash", "canonical_paths", "issued_at", "expires_at", "nonce", "scope", "actor", "session_id", "turn_id", "identity_level", "revocation_state", "signature"],
  "properties": {
    "issuer": {"type": "string", "minLength": 1},
    "promotion_id": {"type": "string", "minLength": 1},
    "candidate_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "before_manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "canonical_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "issued_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 1},
    "scope": {"const": "clarification-promotion"},
    "actor": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "identity_level": {"enum": ["interaction-attested", "trusted-user-identity"]},
    "revocation_state": {"const": "active"},
    "signature": {"type": "string", "minLength": 1}
  }
}
