{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vdd-source-freeze-manifest.v1",
  "type": "object",
  "required": ["schema_version", "run_id", "target_root", "package_root", "selection_hash", "canonical_hash", "sources", "authorizes"],
  "properties": {
    "schema_version": {"const": "vdd-source-freeze-manifest.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "target_root": {"type": "string", "minLength": 1},
    "package_root": {"type": "string", "minLength": 1},
    "selection_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "canonical_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sources": {"type": "array", "minItems": 1},
    "authorizes": {"const": []}
  },
  "additionalProperties": true
}
