{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vdd-repair-input.v1",
  "type": "object",
  "required": ["schema_version", "repair_id", "target_root", "frozen_authority", "review_run", "prior_requirements_manifest", "repaired_requirements_manifest", "validator", "policy", "ambiguity_ids", "affected_requirement_ids", "ambiguity", "allowed_repair_scope", "authorizes"],
  "properties": {
    "schema_version": {"const": "vdd-repair-input.v1"},
    "repair_id": {"type": "string", "minLength": 1},
    "target_root": {"type": "string", "minLength": 1},
    "frozen_authority": {"type": "object", "required": ["source_manifest", "source_manifest_canonical_hash", "role_graph_hash"], "additionalProperties": false, "properties": {"source_manifest": {"$ref": "#/$defs/artifact"}, "source_manifest_canonical_hash": {"$ref": "#/$defs/hash"}, "role_graph_hash": {"$ref": "#/$defs/hash"}}},
    "review_run": {"$ref": "#/$defs/artifact"},
    "prior_requirements_manifest": {"$ref": "#/$defs/artifact"},
    "repaired_requirements_manifest": {"$ref": "#/$defs/artifact"},
    "validator": {"$ref": "#/$defs/artifact"},
    "policy": {"$ref": "#/$defs/artifact"},
    "ambiguity_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "affected_requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "ambiguity": {"type": "array", "items": {"type": "object", "required": ["obligation_ids", "requirement_ids", "reason", "scope"], "additionalProperties": false, "properties": {"obligation_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "reason": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}}}},
    "allowed_repair_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authorizes": {"const": []}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifact": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false, "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}}
  },
  "additionalProperties": false
}
