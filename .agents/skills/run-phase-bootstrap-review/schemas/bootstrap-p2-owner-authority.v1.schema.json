{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/bootstrap-p2-owner-authority.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "owner", "findingId", "reviewId", "inputHash", "candidateHash", "policyRevision", "authorityRevision", "scope", "status", "issuedAt", "expiresAt", "authorizes", "doesNotAuthorize"],
  "properties": {
    "schemaVersion": {"const": "bootstrap-p2-owner-authority.v1"},
    "receiptId": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "findingId": {"type": "string", "minLength": 1}, "reviewId": {"type": "string", "minLength": 1},
    "inputHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "candidateHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "policyRevision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "authorityRevision": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1}, "status": {"const": "active"}, "issuedAt": {"type": "string", "format": "date-time"}, "expiresAt": {"type": "string", "format": "date-time"},
    "authorizes": {"type": "array", "maxItems": 0}, "doesNotAuthorize": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["implementation-acceptance", "protected-handoff", "release", "commit", "done"]}}
  }
}
