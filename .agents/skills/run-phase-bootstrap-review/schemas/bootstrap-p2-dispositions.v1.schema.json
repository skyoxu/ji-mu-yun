{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/bootstrap-p2-dispositions.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "inputHash", "findingIds", "dispositions"],
  "properties": {
    "schemaVersion": {"const": "bootstrap-p2-dispositions.v1"},
    "reviewId": {"type": "string", "minLength": 1},
    "inputHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "findingIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "status", "risk", "reason"],
        "properties": {
          "findingId": {"type": "string", "minLength": 1},
          "status": {"enum": ["fixed", "refuted", "deferred"]},
          "risk": {"enum": ["normal", "high"]},
          "reason": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "expiry": {"type": "string", "minLength": 1},
          "closureCommandId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
          "ownerAuthorityRef": {"$ref": "#/$defs/evidenceRef"},
          "closureCommandRegistryRef": {"$ref": "#/$defs/evidenceRef"},
          "nonImpactEvidenceRef": {"$ref": "#/$defs/evidenceRef"},
          "recheckEvidenceRef": {"$ref": "#/$defs/evidenceRef"},
          "recheckTrigger": {"type": "string", "minLength": 1},
          "closureProcessResultRef": {"$ref": "#/$defs/evidenceRef"}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "deferred"}}, "required": ["status"]}, "then": {"required": ["owner", "expiry", "closureCommandId", "closureCommandRegistryRef", "ownerAuthorityRef", "nonImpactEvidenceRef", "recheckEvidenceRef", "recheckTrigger"]}},
          {"if": {"properties": {"status": {"enum": ["fixed", "refuted"]}}, "required": ["status"]}, "then": {"required": ["closureCommandId", "closureCommandRegistryRef", "closureProcessResultRef"]}}
        ]
      }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
