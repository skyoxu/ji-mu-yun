{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/bootstrap-p2-command-registry.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "reviewId", "inputHash", "candidateHash", "policyRevision", "authorityRevision", "commands", "authorizes", "doesNotAuthorize"],
  "properties": {
    "schemaVersion": {"const": "bootstrap-p2-command-registry.v1"}, "registryId": {"type": "string", "minLength": 1}, "reviewId": {"type": "string", "minLength": 1},
    "inputHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "candidateHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "policyRevision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "authorityRevision": {"type": "string", "minLength": 1},
    "commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["commandId", "commandClass"], "properties": {"commandId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "commandClass": {"enum": ["p2-recheck", "p2-closure"]}}}},
    "authorizes": {"type": "array", "maxItems": 0}, "doesNotAuthorize": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["implementation-acceptance", "protected-handoff", "release", "commit", "done"]}}
  }
}
