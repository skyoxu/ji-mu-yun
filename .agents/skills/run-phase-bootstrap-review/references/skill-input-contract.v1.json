{
  "schema_version": "skill-input-contract.v1",
  "consumer": "run-phase-bootstrap-review",
  "mode": "strict",
  "trigger": "after closure selection, before Artifact View freeze or reviewer launch",
  "source_roles": {
    "closure_inputs": {"selector": "closure_inputs", "required": true, "root": "repository", "allowed_kinds": ["file", "directory"], "reference_kinds": ["markdown-link", "json-path-field"]},
    "authority": {"selector": "authority", "required": true, "root": "repository", "allowed_kinds": ["file", "directory"], "reference_kinds": ["markdown-link", "json-path-field"]}
  },
  "operations": {
    "review": {"required_inputs": ["closure_inputs", "authority"]}
  },
  "reference_policy": "declared-in-root-and-contained",
  "max_reference_depth": 8,
  "max_sources": 128,
  "max_context_bytes": 6000,
  "max_snapshot_bytes": 2097152,
  "semantic_input_mode": "paged-frozen-snapshot-stdin",
  "max_snapshot_chunk_bytes": 24576,
  "budget_basis": {"path": ".agents/skills/run-phase-bootstrap-review/references/skill-input-budget.paged-v1.json", "sha256": "sha256:bd089175c34ef975b585f2284d9b109ad52592e3da172cc1775bf4f30105ba47"},
  "sensitivity_policy": "deny-credential-values",
  "redaction_profile": "credential-values-v1",
  "forbidden_sources": ["logs-as-recovery-source"],
  "semantic_acceptance": "all-required-inputs-are-sufficient"
}
