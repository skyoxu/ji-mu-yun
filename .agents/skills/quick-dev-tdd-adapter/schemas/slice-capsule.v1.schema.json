{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.slice-capsule.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "slice_id", "run_id", "capsule_id", "stage", "authority_refs", "implementation_contract", "requirement_ids", "acceptance_ids", "source_refs", "baseline_ref", "stage_evidence_refs", "boundaries", "target_command_ids", "exit_predicate", "latest_blocker_ref", "predecessor_capsule_hash", "immutable", "authorizes", "does_not_authorize"],
  "properties": {
    "schema_version": {"const": "jimuyun.slice-capsule.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "pattern": "^RMAP-S[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "capsule_id": {"type": "string", "pattern": "^CAP-[0-9]{3,}$"},
    "stage": {"enum": ["prepare", "red", "green", "refactor", "finalize-candidate"]},
    "authority_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
    "implementation_contract": {"$ref": "#/$defs/artifactRef"},
    "requirement_ids": {"$ref": "#/$defs/stringArray"},
    "acceptance_ids": {"$ref": "#/$defs/stringArray"},
    "source_refs": {"$ref": "#/$defs/stringArray"},
    "baseline_ref": {"$ref": "#/$defs/artifactRef"},
    "stage_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
    "boundaries": {"$ref": "#/$defs/boundaries"},
    "target_command_ids": {"$ref": "#/$defs/stringArray"},
    "exit_predicate": {"enum": ["slice-ready", "implementation-candidate", "implementation-accepted"]},
    "latest_blocker_ref": {"type": ["object", "null"], "additionalProperties": false, "required": ["role", "path_type", "path", "sha256"], "properties": {"role": {"type": "string", "minLength": 1}, "path_type": {"enum": ["repo_path", "plan_path", "run_path"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "predecessor_capsule_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "immutable": {"const": true},
    "authorizes": {"const": []},
    "does_not_authorize": {"$ref": "#/$defs/stringArray"}
  },
  "$defs": {
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["role", "path_type", "path", "sha256"], "properties": {"role": {"type": "string", "minLength": 1}, "path_type": {"enum": ["repo_path", "plan_path", "run_path"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "boundaries": {"type": "object", "additionalProperties": false, "required": ["allowed_write_set", "forbidden_write_set", "execution_read_set", "dependency_closure"], "properties": {"allowed_write_set": {"$ref": "#/$defs/stringArray"}, "forbidden_write_set": {"$ref": "#/$defs/stringArray"}, "execution_read_set": {"$ref": "#/$defs/stringArray"}, "dependency_closure": {"$ref": "#/$defs/stringArray"}}}
  }
}
