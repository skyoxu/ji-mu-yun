{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.attempt-ledger-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "slice_id", "run_id", "attempts", "run_events_hash", "final_event_hash", "root_hash"],
  "properties": {
    "schema_version": {"const": "jimuyun.attempt-ledger-manifest.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "pattern": "^RMAP-S[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "stage", "request_hash", "response_hash", "diff_hash", "decision_hash", "stage_result_hash"],
        "properties": {
          "attempt_id": {"type": "string", "pattern": "^ATTEMPT-[0-9]{3,}$"},
          "stage": {"enum": ["red", "green", "refactor"]},
          "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "response_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "diff_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "decision_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "stage_result_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "run_events_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "final_event_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "root_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
