{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.context-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "slice_id", "run_id", "capsule_id", "stage", "capsule_ref", "artifact_refs", "context_hash", "predecessor_capsule_hash", "immutable", "contains_sensitive_data"],
  "properties": {
    "schema_version": {"const": "jimuyun.context-manifest.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "pattern": "^RMAP-S[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "capsule_id": {"type": "string", "pattern": "^CAP-[0-9]{3,}$"},
    "stage": {"enum": ["prepare", "red", "green", "refactor", "finalize-candidate"]},
    "capsule_ref": {"$ref": "#/$defs/artifactRef"},
    "artifact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
    "context_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "predecessor_capsule_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "immutable": {"const": true},
    "contains_sensitive_data": {"const": false}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path_type", "path", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "path_type": {"enum": ["repo_path", "plan_path", "run_path"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
