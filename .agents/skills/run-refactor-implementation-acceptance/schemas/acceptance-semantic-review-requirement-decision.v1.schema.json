{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "decisionVersion", "requirement", "reasonCodes", "requirementSources", "inputHashes", "authorizes"],
  "properties": {
    "schemaVersion": {"const": "acceptance-semantic-review-requirement-decision.v1"},
    "decisionVersion": {"const": "v6"},
    "requirement": {"enum": ["required", "not_required"]},
    "reasonCodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requirementSources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputHashes": {"type": "object"},
    "authorizes": {"const": []}
  },
  "additionalProperties": true
}
