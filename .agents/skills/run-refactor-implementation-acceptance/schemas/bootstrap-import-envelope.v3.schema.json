{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/bootstrap-import-envelope.v3.schema.json",
  "title": "Bootstrap Import Envelope v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "controlPlaneRevision", "bootstrapRunDir", "finalizedRun",
    "finalizedRunCoreHash", "inventoryAttestation", "inventoryAttestationHash",
    "bindingHash", "scopeHash", "candidateIdentity", "candidateIdentityHash",
    "bootstrapRoutePath", "bootstrapRouteFileHash", "bootstrapRouteHash", "authorizes"
  ],
  "properties": {
    "schemaVersion": {"const": "bootstrap-import-envelope.v3"},
    "controlPlaneRevision": {"const": "bootstrap-control-plane.v2"},
    "bootstrapRunDir": {"type": "string", "minLength": 1},
    "finalizedRun": {"$ref": "#/$defs/finalizedRun"},
    "finalizedRunCoreHash": {"$ref": "#/$defs/hash"},
    "inventoryAttestation": {"$ref": "#/$defs/inventoryAttestation"},
    "inventoryAttestationHash": {"$ref": "#/$defs/hash"},
    "bindingHash": {"$ref": "#/$defs/hash"},
    "scopeHash": {"$ref": "#/$defs/hash"},
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "acceptanceRunInputPath", "acceptanceRunInputFileHash",
        "candidateContentManifestPath", "candidateContentManifestFileHash",
        "candidateContentManifestHash", "candidateCustodyHash", "changedPaths",
        "changedPathBindings", "knowledgeArtifacts", "authorizes", "identityHash"
      ],
      "properties": {
        "schemaVersion": {"const": "acceptance-bootstrap-reuse-candidate.v2"},
        "acceptanceRunInputPath": {"type": "string", "minLength": 1},
        "acceptanceRunInputFileHash": {"$ref": "#/$defs/hash"},
        "candidateContentManifestPath": {"type": "string", "minLength": 1},
        "candidateContentManifestFileHash": {"$ref": "#/$defs/hash"},
        "candidateContentManifestHash": {"$ref": "#/$defs/hash"},
        "candidateCustodyHash": {"$ref": "#/$defs/hash"},
        "changedPaths": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "changedPathBindings": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "state", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "state": {"enum": ["present", "deleted"]},
              "sha256": {"$ref": "#/$defs/hash"}
            }
          }
        },
        "knowledgeArtifacts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/hash"}
            }
          }
        },
        "authorizes": {"type": "array", "maxItems": 0},
        "identityHash": {"$ref": "#/$defs/hash"}
      }
    },
    "candidateIdentityHash": {"$ref": "#/$defs/hash"},
    "bootstrapRoutePath": {"type": "string", "minLength": 1},
    "bootstrapRouteFileHash": {"$ref": "#/$defs/hash"},
    "bootstrapRouteHash": {"$ref": "#/$defs/hash"},
    "authorizes": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nullableHash": {
      "oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]
    },
    "finalizedRun": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schemaVersion", "validationStatus", "reviewId", "changeId", "lineageFamilyId",
        "fullReviewRound", "profileName", "reviewProfile", "routeVersion",
        "controlPlaneRevision", "policyRevision", "profileHash", "authorityRevision",
        "inputHash", "authorityContextHash", "candidateBindingHash",
        "reviewEntryDecisionHash", "repairReviewDeltaHash", "artifactHashes",
        "finalStatus", "findingClosure", "validatorRevision", "validatorHash",
        "authorizes", "doesNotAuthorize", "generatedAt"
      ],
      "properties": {
        "schemaVersion": {"const": "bootstrap-finalized-run-validation.v3"},
        "validationStatus": {"const": "passed"},
        "reviewId": {"type": "string", "minLength": 1},
        "changeId": {"type": "string", "minLength": 1},
        "lineageFamilyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
        "fullReviewRound": {"type": "integer", "minimum": 1, "maximum": 3},
        "profileName": {"const": "bootstrap-implementation-conformance"},
        "reviewProfile": {"const": "review-policy://bootstrap-implementation-conformance/v1"},
        "routeVersion": {"type": "string", "minLength": 1},
        "controlPlaneRevision": {"const": "bootstrap-control-plane.v2"},
        "policyRevision": {"$ref": "#/$defs/hash"},
        "profileHash": {"$ref": "#/$defs/hash"},
        "authorityRevision": {"type": "string", "minLength": 1},
        "inputHash": {"$ref": "#/$defs/hash"},
        "authorityContextHash": {"$ref": "#/$defs/hash"},
        "candidateBindingHash": {"$ref": "#/$defs/hash"},
        "reviewEntryDecisionHash": {"$ref": "#/$defs/nullableHash"},
        "repairReviewDeltaHash": {"$ref": "#/$defs/nullableHash"},
        "artifactHashes": {
          "type": "object", "additionalProperties": false,
          "required": [
            "reviewInput", "preflightResult", "gateState", "candidates", "rejections",
            "finalResult", "dispositions", "metrics", "verifierOutput", "p2Dispositions"
          ],
          "properties": {
            "reviewInput": {"$ref": "#/$defs/hash"},
            "preflightResult": {"$ref": "#/$defs/hash"},
            "gateState": {"$ref": "#/$defs/hash"},
            "candidates": {"$ref": "#/$defs/hash"},
            "rejections": {"$ref": "#/$defs/hash"},
            "finalResult": {"$ref": "#/$defs/hash"},
            "dispositions": {"$ref": "#/$defs/hash"},
            "metrics": {"$ref": "#/$defs/hash"},
            "verifierOutput": {"$ref": "#/$defs/hash"},
            "p2Dispositions": {"$ref": "#/$defs/nullableHash"}
          }
        },
        "finalStatus": {"const": "clean"},
        "findingClosure": {
          "type": "object", "additionalProperties": false,
          "required": [
            "candidateCount", "visibleFindingCount", "confirmedCount", "advisoryCount",
            "unverifiedCount", "refutedCount", "p2FixedCount", "p2DeferredCount",
            "p2RefutedCount"
          ],
          "properties": {
            "candidateCount": {"type": "integer", "minimum": 0},
            "visibleFindingCount": {"type": "integer", "minimum": 0},
            "confirmedCount": {"type": "integer", "minimum": 0},
            "advisoryCount": {"type": "integer", "minimum": 0},
            "unverifiedCount": {"type": "integer", "minimum": 0},
            "refutedCount": {"type": "integer", "minimum": 0},
            "p2FixedCount": {"type": "integer", "minimum": 0},
            "p2DeferredCount": {"type": "integer", "minimum": 0},
            "p2RefutedCount": {"type": "integer", "minimum": 0}
          }
        },
        "validatorRevision": {"const": "bootstrap-finalized-run-validator.v4"},
        "validatorHash": {"$ref": "#/$defs/hash"},
        "authorizes": {"type": "array", "maxItems": 0},
        "doesNotAuthorize": {
          "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
          "items": {
            "enum": [
              "plan-acceptance", "implementation-acceptance", "protected-handoff",
              "release", "commit", "done"
            ]
          }
        },
        "generatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "inventoryAttestation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schemaVersion", "reviewId", "attemptId", "inputHash", "capabilityId",
        "capabilityVersion", "producerRole", "status", "scopeHash", "coverage"
      ],
      "properties": {
        "schemaVersion": {"const": "bootstrap-acceptance-inventory-attestation.v1"},
        "reviewId": {"type": "string", "minLength": 1},
        "attemptId": {"type": "string", "minLength": 1},
        "inputHash": {"$ref": "#/$defs/hash"},
        "capabilityId": {"const": "acceptance-inventory-attestation"},
        "capabilityVersion": {"const": "1.0"},
        "producerRole": {"const": "acceptance_auditor"},
        "status": {"const": "complete"},
        "scopeHash": {"$ref": "#/$defs/hash"},
        "coverage": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
