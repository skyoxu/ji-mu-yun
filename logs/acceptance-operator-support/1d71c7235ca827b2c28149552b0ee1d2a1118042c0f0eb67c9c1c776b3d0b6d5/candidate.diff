+        normalized.startswith("docs/") or normalized.startswith("_bmad-output/")
+    ):
+        return True
+    governance_tokens = (
+        ".memlog", "architecture-decision-registry", "architecture-spine",
+        "/reviews/", "review-", "candidate-binding", "authorization",
+    )
+    return any(token in lower