                ledger.claim(key, now=5, ttl_seconds=cases["invalid_ttl"]),
                ledger.claim(key, now=5, ttl_seconds=10),
            )
            expected = ("invalid-ttl", "accepted")
        else:
            result = ledger.release(cases["missing_release"])
            expected = "not-found"
    
