{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.repository-knowledge-query-suite.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_revision", "minimum_positive_cases_per_category", "categories", "cases"],
  "properties": {
    "schema_version": {"const": "jimuyun.repository-knowledge-query-suite.v1"},
    "policy_revision": {"const": "knowledge-consumer-policies.v2"},
    "minimum_positive_cases_per_category": {"type": "integer", "minimum": 25},
    "categories": {
      "type": "array",
      "const": ["adr", "execution-plan", "architecture", "toolchain"]
    },
    "cases": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "category", "consumer", "query", "expected"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^(ADR|PLAN|ARCH|TOOL)-([0-9]{3}|N[0-9]{2})$"},
          "category": {"enum": ["adr", "execution-plan", "architecture", "toolchain"]},
          "consumer": {"enum": ["vdd", "bootstrap", "refactor-acceptance"]},
          "query": {"type": "string", "minLength": 3},
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["module_id", "max_rank", "kind", "status", "path", "source_terms"],
                "properties": {
                  "result_status": {"const": "matched"},
                  "module_id": {"type": "string", "minLength": 1},
                  "max_rank": {"type": "integer", "minimum": 1, "maximum": 20},
                  "kind": {"type": "string", "minLength": 1},
                  "status": {"enum": ["active", "conditional", "historical"]},
                  "path": {"type": "string", "minLength": 1},
                  "source_terms": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 2},
                    "uniqueItems": true
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["result_status"],
                "properties": {"result_status": {"const": "insufficient_match"}}
              }
            ]
          }
        }
      }
    }
  }
}
