{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.knowledge-publication-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "phase", "error", "main_commit", "recorded_at", "evaluation_report_path", "evaluation_report_sha256"],
  "properties": {
    "schema_version": {"const": "jimuyun.knowledge-publication-report.v1"},
    "status": {"const": "failed"},
    "phase": {"type": "string", "minLength": 1},
    "error": {"type": "string", "minLength": 1},
    "main_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "evaluation_report_path": {"type": ["string", "null"]},
    "evaluation_report_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
