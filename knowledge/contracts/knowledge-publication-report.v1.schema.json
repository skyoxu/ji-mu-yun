{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.knowledge-publication-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "phase", "error", "main_commit", "recorded_at", "evaluation_report_path", "evaluation_report_sha256"],
  "properties": {
    "schema_version": {"const": "jimuyun.knowledge-publication-report.v1"},
    "status": {"const": "failed"},
    "phase": {"type": "string", "minLength": 1},
    "error": {"type": "string", "minLength": 1},
    "main_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "evaluation_report_path": {"type": ["string", "null"]},
    "evaluation_report_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "publication_request": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["request_id", "caller", "trigger", "target_plan", "request_sha256", "source_route"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "caller": {"const": "maintain-knowledge-base"},
        "trigger": {"enum": ["operator-requested", "catalog-stale-maintenance"]},
        "target_plan": {"type": "string", "pattern": "^execution-plans/(?!\\.\\.?$)[^/\\\\]+$"},
        "request_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_route": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          ]
        }
      }
    }
  }
}
