{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.repository-source-snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ref", "commit", "exclusion_policy_revision", "sources", "snapshot_id"],
  "properties": {
    "schema_version": {"const": "jimuyun.repository-source-snapshot.v1"},
    "ref": {"const": "refs/heads/main"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "exclusion_policy_revision": {"const": "knowledge-source-exclusions.v1"},
    "snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "source_role"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "not": {"pattern": "^docs/migration/"}},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_role": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
