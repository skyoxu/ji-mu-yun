{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ji-mu-yun.invalid/schemas/original-requirement-family-registry.v1.schema.json",
  "title": "Original Requirement Family Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provenance", "coverageMode", "families"],
  "properties": {
    "schemaVersion": {"const": "original-requirement-family-registry.v1"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceArtifactStatus", "statement", "semanticFamilyPayloadHashSha256", "approvedBy", "approvedUtc", "approvalEvidenceRefs"],
      "properties": {
        "sourceArtifactStatus": {"const": "pre_split_bytes_unavailable"},
        "statement": {"type": "string", "minLength": 1},
        "semanticFamilyPayloadHashSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approvedBy": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "approvedUtc": {"type": "string", "format": "date-time"},
        "approvalEvidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "coverageMode": {"const": "approved-semantic-family"},
    "families": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "owners", "acceptanceRef", "acceptance"],
        "properties": {
          "id": {"type": "string", "pattern": "^ORIG-[0-9]{2}$"},
          "name": {"type": "string", "minLength": 1},
          "owners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "acceptanceRef": {"type": "string", "pattern": "^phase-boundary://original-requirements/ORIG-[0-9]{2}/acceptance$"},
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "evidenceIntent"],
            "properties": {
              "criterion": {"type": "string", "minLength": 1},
              "evidenceIntent": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
