{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ji-mu-yun.invalid/schemas/upstream-handoff-manifest.v1.schema.json",
  "title": "UpstreamHandoffManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "handoffId", "handoffEpoch", "upstreamPlanId", "finalCommit", "branch", "createdUtc", "bootstrapContractHash", "phaseClosure", "sourceMapHash", "completionSnapshots", "bundleHashes", "approvers", "signatures"],
  "properties": {
    "schemaId": {"const": "upstream-handoff-manifest"},
    "schemaVersion": {"const": "1"},
    "handoffId": {"type": "string", "minLength": 1},
    "handoffEpoch": {"type": "integer", "minimum": 1},
    "upstreamPlanId": {"type": "string", "minLength": 1},
    "finalCommit": {"$ref": "#/$defs/gitCommit"},
    "branch": {"type": "string", "minLength": 1},
    "createdUtc": {"type": "string", "format": "date-time"},
    "bootstrapContractHash": {"$ref": "#/$defs/sha256"},
    "phaseClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phaseExitRefs", "globalReviewRef", "unresolvedFindingCount", "capabilityDeferrals"],
      "properties": {
        "phaseExitRefs": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "globalReviewRef": {"type": "string", "minLength": 1},
        "unresolvedFindingCount": {"const": 0},
        "capabilityDeferrals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capabilityDeferral"}}
      }
    },
    "sourceMapHash": {"$ref": "#/$defs/sha256"},
    "completionSnapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeManifestHash", "beforeSignatureHash", "schemaHash", "pathAllowlistHash"],
      "properties": {
        "beforeManifestHash": {"$ref": "#/$defs/sha256"},
        "beforeSignatureHash": {"$ref": "#/$defs/sha256"},
        "schemaHash": {"$ref": "#/$defs/sha256"},
        "pathAllowlistHash": {"$ref": "#/$defs/sha256"}
      }
    },
    "bundleHashes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "approvers": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "signatures": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/signature"}}
  },
  "$defs": {
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signerId", "keyId", "algorithm", "payloadHash", "signature"],
      "properties": {
        "signerId": {"type": "string", "minLength": 1},
        "keyId": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "payloadHash": {"$ref": "#/$defs/sha256"},
        "signature": {"type": "string", "minLength": 1}
      }
    },
    "capabilityDeferral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deferralId", "capabilityId", "disposition", "owner", "expiresUtc", "recheckRef", "evidenceRefs", "reason"],
      "properties": {
        "deferralId": {"type": "string", "pattern": "^DEF-[0-9]{3,}$"},
        "capabilityId": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["consumed", "preserved", "excluded"]},
        "owner": {"type": "string", "minLength": 1},
        "expiresUtc": {"type": "string", "format": "date-time"},
        "recheckRef": {"type": "string", "minLength": 1},
        "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
