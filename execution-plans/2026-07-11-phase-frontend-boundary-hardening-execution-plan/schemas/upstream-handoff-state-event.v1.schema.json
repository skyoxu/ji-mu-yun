{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ji-mu-yun.invalid/schemas/upstream-handoff-state-event.v1.schema.json",
  "title": "UpstreamHandoffStateEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaId", "schemaVersion", "eventId", "handoffId", "handoffEpoch", "state", "previousEventHash", "reasonCode", "triggerEvidenceRefs", "createdUtc", "approvers", "signatures"],
  "properties": {
    "schemaId": {"const": "upstream-handoff-state-event"},
    "schemaVersion": {"const": "1"},
    "eventId": {"type": "string", "minLength": 1},
    "handoffId": {"type": "string", "minLength": 1},
    "handoffEpoch": {"type": "integer", "minimum": 1},
    "state": {"enum": ["active", "superseded", "revoked"]},
    "previousEventHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "reasonCode": {"type": "string", "minLength": 1},
    "triggerEvidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "createdUtc": {"type": "string", "format": "date-time"},
    "approvers": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "signatures": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/signature"}}
  },
  "oneOf": [
    {"properties": {"state": {"const": "active"}, "previousEventHash": {"const": null}}},
    {"properties": {"state": {"enum": ["superseded", "revoked"]}, "previousEventHash": {"$ref": "#/$defs/sha256"}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signerId", "keyId", "algorithm", "payloadHash", "signature"],
      "properties": {
        "signerId": {"type": "string", "minLength": 1},
        "keyId": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "payloadHash": {"$ref": "#/$defs/sha256"},
        "signature": {"type": "string", "minLength": 1}
      }
    }
  }
}
