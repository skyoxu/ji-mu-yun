{
  "schema_version": "kwi.protocol-cases.v1",
  "cases": [
    {"case_id": "adapter-owned-envelope", "kind": "positive", "consumer": "vdd", "condition": "adapter owns authority, path, domain, budget and snapshot", "expected": "matched-or-insufficient"},
    {"case_id": "llm-owned-envelope", "kind": "negative", "consumer": "locator", "condition": "LLM attempts to own the trusted envelope", "expected": "blocked", "failure_code": "KWI-CONTRACT-LLM-OWNER"},
    {"case_id": "generated-answer-field", "kind": "negative", "consumer": "locator", "condition": "result claims a synthesized fact answer", "expected": "blocked", "failure_code": "KWI-LOCATOR-LOCATION-ONLY"},
    {"case_id": "low-confidence-match", "kind": "negative", "consumer": "locator", "condition": "low confidence is labeled matched", "expected": "blocked", "failure_code": "KWI-LOCATOR-LOW-CONFIDENCE"},
    {"case_id": "quick-dev-scope-expansion", "kind": "negative", "consumer": "quick-dev", "condition": "verify-bound adds a path or reclassifies a consumption decision outside frozen context", "covers": ["path-expansion", "decision-reclassification"], "expected": "vdd-repair", "failure_code": "KWI-QUICK-SCOPE-EXPANSION"},
    {"case_id": "bootstrap-post-prepare-growth", "kind": "negative", "consumer": "bootstrap", "condition": "knowledge context or a consumption decision changes after Artifact View freeze", "covers": ["context-growth", "decision-change"], "expected": "stale-run", "failure_code": "KWI-BOOTSTRAP-CONTEXT-DRIFT"},
    {"case_id": "vdd-optional-insufficient", "kind": "positive", "consumer": "vdd", "condition": "only optional modules are insufficient", "expected": "explicit-optional-omission"},
    {"case_id": "vdd-required-missing", "kind": "negative", "consumer": "vdd", "condition": "a required consumer-policy module is absent", "expected": "draft", "failure_code": "KWI-VDD-REQUIRED-MODULE"},
    {"case_id": "high-score-wrong-domain", "kind": "negative", "consumer": "vdd", "condition": "an above-threshold candidate belongs to the wrong repository domain", "candidate_score": "above-threshold", "semantic_fit": false, "expected": "rejected-not-counted", "failure_code": "KWI-CONSUMPTION-WRONG-DOMAIN"},
    {"case_id": "keyword-match-insufficient-specificity", "kind": "negative", "consumer": "bootstrap", "condition": "keywords match but the candidate cannot support the required context class", "candidate_score": "above-threshold", "semantic_fit": false, "expected": "rejected-not-counted", "failure_code": "KWI-CONSUMPTION-INSUFFICIENT-SPECIFICITY"},
    {"case_id": "all-candidates-rejected", "kind": "negative", "consumer": "vdd", "condition": "every candidate for a required module is rejected after reread", "required_module": true, "accepted_count": 0, "expected": "draft", "failure_code": "KWI-CONSUMPTION-REQUIRED-UNCOVERED"},
    {"case_id": "index-concurrent-owner-conflict", "kind": "negative", "consumer": "index-builder", "condition": "a second writer targets the same lifecycle, domain, source snapshot and policy revision while the recorded owner is live", "lock_key_covers": ["lifecycle_identity", "domain", "source_snapshot", "policy_revision"], "lock_owner_covers": ["pid", "process_creation_identity", "token", "acquired_at", "generation"], "expected": "blocked", "failure_code": "KWI-INDEX-LOCK-CONFLICT"},
    {"case_id": "index-verified-generation-reuse", "kind": "positive", "consumer": "index-builder", "condition": "an immutable generation for the exact source snapshot and policy revision already passed validation", "validated_generation": true, "same_snapshot": true, "expected": "reuse-without-write"},
    {"case_id": "index-unvalidated-staging-publish", "kind": "negative", "consumer": "index-builder", "condition": "a staging generation has not passed schema, composition, hash, evaluation and contamination checks", "validation_checks": ["schema", "composition", "hash", "evaluation", "contamination"], "all_checks_passed": false, "expected": "blocked", "failure_code": "KWI-INDEX-STAGING-UNVALIDATED"},
    {"case_id": "index-non-atomic-pointer-update", "kind": "negative", "consumer": "index-builder", "condition": "current.json or last-known-good.json would be changed in place", "pointer_names": ["current.json", "last-known-good.json"], "write_mode": "in-place", "expected": "blocked", "failure_code": "KWI-INDEX-POINTER-NONATOMIC"},
    {"case_id": "index-failed-build-preserves-lkg", "kind": "negative", "consumer": "index-builder", "condition": "a staging build fails before publication", "build_status": "failed", "pointer_advanced": false, "failed_evidence": "sidecar-preserved", "recovery": "last-known-good", "expected": "lkg-preserved", "failure_code": "KWI-INDEX-BUILD-FAILED"}
  ]
}
