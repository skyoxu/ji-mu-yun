{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/review-result.v1.schema.json",
  "title": "Review Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "routeVersion",
    "reviewProfile",
    "policyRevision",
    "requiredLayers",
    "completedLayers",
    "scope",
    "authorityRevision",
    "inputHash",
    "status",
    "failedLayers",
    "skippedLayers",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "const": "review-result.v1" },
    "reviewId": { "type": "string", "minLength": 1 },
    "routeVersion": { "type": "string", "minLength": 1 },
    "reviewProfile": { "type": "string", "pattern": "^review-policy://[a-z0-9-]+/v[0-9]+$" },
    "policyRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "requiredLayers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "blind_hunter",
          "edge_case_hunter",
          "acceptance_auditor",
          "document_reviewer",
          "security_reviewer",
          "manual_reviewer"
        ]
      }
    },
    "completedLayers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "blind_hunter",
          "edge_case_hunter",
          "acceptance_auditor",
          "document_reviewer",
          "security_reviewer",
          "manual_reviewer"
        ]
      }
    },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "authorityRevision": { "type": "string", "minLength": 1 },
    "inputHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["clean", "blocked", "advisory", "incomplete"] },
    "failedLayers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "blind_hunter",
          "edge_case_hunter",
          "acceptance_auditor",
          "document_reviewer",
          "security_reviewer",
          "manual_reviewer"
        ]
      }
    },
    "skippedLayers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewerLayer", "reasonCode", "reason"],
        "properties": {
          "reviewerLayer": {
            "enum": [
              "blind_hunter",
              "edge_case_hunter",
              "acceptance_auditor",
              "document_reviewer",
              "security_reviewer",
              "manual_reviewer"
            ]
          },
          "reasonCode": { "enum": ["not_applicable_no_spec", "disabled_by_scope"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "review-finding.v1.schema.json" },
          { "properties": { "status": { "enum": ["confirmed", "advisory", "unverified"] } } }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "clean" } } },
      "then": {
        "properties": {
          "failedLayers": { "maxItems": 0 },
          "findings": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "failedLayers": { "minItems": 1 } } },
      "then": { "properties": { "status": { "const": "incomplete" } } }
    },
    {
      "if": { "properties": { "status": { "const": "advisory" } } },
      "then": {
        "properties": {
          "failedLayers": { "maxItems": 0 },
          "findings": {
            "minItems": 1,
            "items": {
              "allOf": [
                { "$ref": "review-finding.v1.schema.json" },
                { "properties": { "status": { "const": "advisory" }, "proposedSeverity": { "const": "P2" } } }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": {
        "not": {
          "properties": {
            "findings": {
              "contains": {
                "properties": {
                  "status": { "const": "unverified" },
                  "unverifiedDisposition": { "const": "manual_pause" }
                },
                "required": ["status", "unverifiedDisposition"]
              }
            }
          },
          "required": ["findings"]
        },
        "properties": {
          "failedLayers": { "maxItems": 0 },
          "findings": {
            "contains": {
              "anyOf": [
                {
                  "properties": {
                    "status": { "const": "confirmed" },
                    "proposedSeverity": { "enum": ["P0", "P1"] }
                  },
                  "required": ["status", "proposedSeverity"]
                },
                {
                  "properties": {
                    "status": { "const": "unverified" },
                    "proposedSeverity": { "enum": ["P0", "P1"] },
                    "unverifiedDisposition": { "const": "blocking" }
                  },
                  "required": ["status", "proposedSeverity", "unverifiedDisposition"]
                }
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "incomplete" } } },
      "then": {
        "anyOf": [
          { "properties": { "failedLayers": { "minItems": 1 } } },
          {
            "properties": {
              "findings": {
                "contains": {
                  "properties": {
                    "status": { "const": "unverified" },
                    "unverifiedDisposition": { "const": "manual_pause" }
                  },
                  "required": ["status", "unverifiedDisposition"]
                },
                "minContains": 1
              }
            }
          }
        ]
      }
    }
  ]
}
