{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/bootstrap-review-gate-result.v1.schema.json",
  "title": "Bootstrap Review Gate Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityClass",
    "reviewId",
    "routeVersion",
    "reviewProfile",
    "policyRevision",
    "authorityRevision",
    "inputHash",
    "requiredLayers",
    "completedLayers",
    "failedLayers",
    "layerFailures",
    "status",
    "candidateCount",
    "blockerCandidateCount",
    "rejectionCount",
    "preflightResultHash",
    "candidatesHash",
    "rejectionsHash"
  ],
  "properties": {
    "schemaVersion": { "const": "bootstrap-review-gate-result.v1" },
    "authorityClass": { "const": "supplemental_bootstrap" },
    "reviewId": { "type": "string", "minLength": 1 },
    "routeVersion": { "type": "string", "minLength": 1 },
    "reviewProfile": { "type": "string", "pattern": "^review-policy://[a-z0-9-]+/v[0-9]+$" },
    "policyRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "authorityRevision": { "type": "string", "minLength": 1 },
    "inputHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "requiredLayers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["blind_hunter", "edge_case_hunter", "acceptance_auditor"] }
    },
    "completedLayers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["blind_hunter", "edge_case_hunter", "acceptance_auditor"] }
    },
    "failedLayers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["blind_hunter", "edge_case_hunter", "acceptance_auditor"] }
    },
    "layerFailures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewerLayer", "reason"],
        "properties": {
          "reviewerLayer": { "enum": ["blind_hunter", "edge_case_hunter", "acceptance_auditor"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "status": { "enum": ["clean", "advisory", "incomplete", "awaiting_verification"] },
    "candidateCount": { "type": "integer", "minimum": 0 },
    "blockerCandidateCount": { "type": "integer", "minimum": 0 },
    "rejectionCount": { "type": "integer", "minimum": 0 },
    "preflightResultHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "candidatesHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "rejectionsHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "clean" } } },
      "then": {
        "properties": {
          "failedLayers": { "maxItems": 0 },
          "layerFailures": { "maxItems": 0 },
          "candidateCount": { "const": 0 },
          "blockerCandidateCount": { "const": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "advisory" } } },
      "then": {
        "properties": {
          "failedLayers": { "maxItems": 0 },
          "layerFailures": { "maxItems": 0 },
          "candidateCount": { "minimum": 1 },
          "blockerCandidateCount": { "const": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "awaiting_verification" } } },
      "then": {
        "properties": {
          "failedLayers": { "maxItems": 0 },
          "layerFailures": { "maxItems": 0 },
          "candidateCount": { "minimum": 1 },
          "blockerCandidateCount": { "minimum": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "incomplete" } } },
      "then": {
        "properties": {
          "failedLayers": { "minItems": 1 },
          "layerFailures": { "minItems": 1 }
        }
      }
    }
  ]
}
