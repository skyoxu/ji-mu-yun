{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/bootstrap-review-launch-authorization.v1.schema.json",
  "title": "Bootstrap Review Launch Authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorityClass",
    "reviewId",
    "routeVersion",
    "reviewProfile",
    "policyRevision",
    "authorityRevision",
    "inputHash",
    "changeId",
    "fullReviewRound",
    "authorityContextHash",
    "artifactSetHash",
    "preflightResultHash",
    "reviewCostEstimateHash",
    "highCostAcknowledged",
    "authorizedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "bootstrap-review-launch-authorization.v1" },
    "authorityClass": { "const": "supplemental_bootstrap" },
    "reviewId": { "type": "string", "minLength": 3 },
    "routeVersion": { "type": "string", "minLength": 1 },
    "reviewProfile": { "type": "string", "minLength": 1 },
    "policyRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "authorityRevision": { "type": "string", "minLength": 1 },
    "inputHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "changeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "fullReviewRound": { "type": "integer", "minimum": 1, "maximum": 3 },
    "authorityContextHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifactSetHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "preflightResultHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reviewCostEstimateHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "highCostAcknowledged": { "type": "boolean" },
    "authorizedAt": { "type": "string", "format": "date-time" }
  }
}
