  "type": "object",
  "required": ["schema_version", "status", "target_package", "resolved_validator", "authorizes"],
  "properties": {
    "schema_version": {"const": "jimuyun.skill-package-validation-receipt.v1"},
    "status": {"enum": ["pass", "expected-failure"]},
    "target_package": {"type": "string", "minLength": 1},
    "resolved_validator": {"type": "object"},
    "authorizes": {"const": []}
  },
  "additionalProperties": true
}
