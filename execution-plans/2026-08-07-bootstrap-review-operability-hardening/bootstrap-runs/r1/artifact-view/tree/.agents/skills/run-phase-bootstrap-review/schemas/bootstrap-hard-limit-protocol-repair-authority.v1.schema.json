{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/bootstrap-hard-limit-protocol-repair-authority.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "maintenanceMode", "lineageFamilyId", "fullReviewRound", "predecessorRun", "predecessorInputHash", "blockedPredecessorEnvelope", "focusedRun", "focusedInputHash", "hardLimitRecoveryHash", "deterministicRepairClosureHash", "findingIds", "focusedValidationEnvelope", "verifierOutputHash", "gateHash", "generatedAt", "authorizes", "doesNotAuthorize"],
  "properties": {
    "schemaVersion": {"const": "bootstrap-hard-limit-protocol-repair-authority.v1"},
    "status": {"const": "passed"},
    "maintenanceMode": {"const": "ai-native-single-maintainer"},
    "lineageFamilyId": {"type": "string", "minLength": 3},
    "fullReviewRound": {"const": 3},
    "predecessorRun": {"$ref": "#/$defs/path"},
    "predecessorInputHash": {"$ref": "#/$defs/hash"},
    "blockedPredecessorEnvelope": {"$ref": "#/$defs/fileBindingWithStatus"},
    "focusedRun": {"$ref": "#/$defs/path"},
    "focusedInputHash": {"$ref": "#/$defs/hash"},
    "hardLimitRecoveryHash": {"$ref": "#/$defs/hash"},
    "deterministicRepairClosureHash": {"$ref": "#/$defs/hash"},
    "findingIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "focusedValidationEnvelope": {"$ref": "#/$defs/fileBinding"},
    "verifierOutputHash": {"$ref": "#/$defs/hash"},
    "gateHash": {"$ref": "#/$defs/hash"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "authorizes": {"const": ["manual-pause-protocol-review"]},
    "doesNotAuthorize": {"const": ["acceptance-passed", "round-4", "finding-discovery", "commit", "release"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "fileBinding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "fileBindingWithStatus": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "finalStatus"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}, "finalStatus": {"const": "blocked"}}}
  }
}
