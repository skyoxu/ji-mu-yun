{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/review-rejection.v1.schema.json",
  "title": "Review Rejection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "reviewerLayer",
    "routeVersion",
    "authorityRevision",
    "inputHash",
    "candidateHash",
    "suppressionFingerprint",
    "reasonCode",
    "reason"
  ],
  "properties": {
    "schemaVersion": { "const": "review-rejection.v1" },
    "candidateId": { "type": "string", "minLength": 1 },
    "reviewerLayer": {
      "enum": [
        "blind_hunter",
        "edge_case_hunter",
        "acceptance_auditor",
        "document_reviewer",
        "security_reviewer",
        "manual_reviewer"
      ]
    },
    "routeVersion": { "type": "string", "minLength": 1 },
    "authorityRevision": { "type": "string", "minLength": 1 },
    "inputHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "candidateHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "suppressionFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reasonCode": {
      "enum": [
        "schema_invalid",
        "missing_location",
        "missing_failure_tuple",
        "missing_context",
        "missing_guard_analysis",
        "low_confidence",
        "severity_unsupported",
        "stale_evidence",
        "duplicate",
        "suppressed_disposition"
      ]
    },
    "reason": { "type": "string", "minLength": 1 }
  }
}
