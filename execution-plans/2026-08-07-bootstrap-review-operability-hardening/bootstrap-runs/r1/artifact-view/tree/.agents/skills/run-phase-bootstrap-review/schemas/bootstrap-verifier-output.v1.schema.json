{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/bootstrap-verifier-output.v1.schema.json",
  "title": "Bootstrap Verifier Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "reviewId", "routeVersion", "authorityRevision", "inputHash", "decisions"
  ],
  "properties": {
    "schemaVersion": { "const": "bootstrap-verifier-output.v1" },
    "reviewId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "routeVersion": { "type": "string", "minLength": 1 },
    "authorityRevision": { "type": "string", "minLength": 1 },
    "inputHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "decision", "reason", "evidenceChecked"],
        "properties": {
          "findingId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{4,63}$" },
          "decision": { "enum": ["confirmed", "refuted", "unverified"] },
          "reason": { "type": "string", "minLength": 1 },
          "evidenceChecked": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "unverifiedClass": { "enum": ["security", "data_loss", "other"] }
        },
        "allOf": [
          {
            "if": { "properties": { "decision": { "const": "unverified" } }, "required": ["decision"] },
            "then": { "required": ["unverifiedClass"] },
            "else": { "not": { "required": ["unverifiedClass"] } }
          }
        ]
      }
    }
  }
}
