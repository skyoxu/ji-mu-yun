{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/bootstrap-preflight-result.v1.schema.json",
  "title": "Bootstrap Preflight Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "reviewId", "routeVersion", "policyRevision",
    "authorityRevision", "inputHash", "status", "checks"
  ],
  "properties": {
    "schemaVersion": { "const": "bootstrap-preflight-result.v1" },
    "reviewId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "routeVersion": { "type": "string", "minLength": 1 },
    "policyRevision": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "authorityRevision": { "type": "string", "minLength": 1 },
    "inputHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "status": { "enum": ["pending", "passed", "failed"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status"],
        "properties": {
          "checkId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
          "status": { "enum": ["pending", "passed", "failed"] },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "evidencePath": { "type": "string", "pattern": "^preflight/[A-Za-z0-9._/-]+$" },
          "evidenceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "failureReason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
