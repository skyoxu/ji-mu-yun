{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimuyun.local/schemas/bootstrap-p2-process-event.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "previousEventHash", "reviewId", "inputHash", "candidateHash", "authorityRevision", "findingId", "commandId", "commandClass", "registryHash", "descriptorHash", "runnerIdentity", "executable", "argv", "cwd", "exitCode", "stdoutPath", "stdoutHash", "stderrPath", "stderrHash", "observedAt", "eventHash"],
  "properties": {
    "schemaVersion": {"const": "bootstrap-p2-process-event.v1"},
    "eventId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
    "previousEventHash": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}]},
    "reviewId": {"type": "string", "minLength": 1}, "inputHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "candidateHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "authorityRevision": {"type": "string", "minLength": 1}, "findingId": {"type": "string", "minLength": 1},
    "commandId": {"type": "string", "minLength": 1}, "commandClass": {"enum": ["p2-recheck", "p2-closure"]}, "registryHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "descriptorHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "runnerIdentity": {"const": "bootstrap-p2-runner.v1"},
    "executable": {"enum": ["py", "python", "python3"]}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "cwd": {"type": "string", "minLength": 1}, "exitCode": {"type": "integer"},
    "stdoutPath": {"type": "string", "minLength": 1}, "stdoutHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "stderrPath": {"type": "string", "minLength": 1}, "stderrHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "observedAt": {"type": "string", "format": "date-time"}, "eventHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
