{"type":"item.completed","item":{"id":"item_9","type":"mcp_tool_call","server":"fastctx","tool":"read","arguments":{"file_path":"C:\\jimuyun\\execution-plans\\2026-08-07-bootstrap-review-operability-hardening\\bootstrap-runs\\r2\\artifact-view\\tree\\.agents\\skills\\run-phase-bootstrap-review\\scripts\\_control_plane.py","offset":1,"limit":500},"result":{"content":[{"type":"text","text":"1\t\"\"\"Deterministic execution and evidence primitives for Bootstrap Review.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport ctypes\n6\timport hashlib\n7\timport json\n8\timport os\n9\timport re\n10\timport secrets\n11\timport subprocess\n12\timport time\n13\tfrom datetime import datetime, timezone\n14\tfrom pathlib import Path\n15\tfrom pathlib import PurePosixPath\n16\tfrom typing import Any\n17\t\n18\t\n19\tHASH_PREFIX = \"sha256:\"\n20\tENVIRONMENT_ALLOWLIST = (\n21\t    \"APPDATA\", \"CODEX_HOME\", \"COMSPEC\", \"HOMEDRIVE\", \"HOMEPATH\", \"LOCALAPPDATA\",\n22\t    \"CURL_CA_BUNDLE\", \"HOME\", \"HTTP_PROXY\", \"HTTPS_PROXY\", \"NO_PROXY\",\n23\t    \"NODE_EXTRA_CA_CERTS\", \"OPENAI_API_KEY\", \"PATH\", \"PATHEXT\", \"PROGRAMDATA\",\n24\t    \"SSL_CERT_FILE\", \"SYSTEMDRIVE\", \"SYSTEMROOT\", \"TEMP\", \"TMP\", \"USERDOMAIN\",\n25\t    \"USERNAME\", \"USERPROFILE\", \"WINDIR\", \"http_proxy\", \"https_proxy\", \"no_proxy\",\n26\t)\n27\tTYPED_PLACEHOLDERS = {\n28\t    \"codex_command\": \"executable_path\",\n29\t    \"model\": \"model_id\",\n30\t    \"reasoning_effort\": \"enum:medium|high|max\",\n31\t    \"sandbox\": \"enum:read-only|workspace-write\",\n32\t    \"output_path\": \"absolute_path\",\n33\t    \"workspace_root\": \"absolute_attempt_path\",\n34\t}\n35\tTERMINAL_EVENT_TYPES = {\n36\t    \"attempt-completed\",\n37\t    \"attempt-failed\",\n38\t    \"attempt-rejected\",\n39\t    \"attempt-stale\",\n40\t}\n41\t\n42\t\n43\tclass ControlPlaneError(Exception):\n44\t    pass\n45\t\n46\t\n47\tclass NoProgressTimeout(ControlPlaneError):\n48\t    def __init__(self, timeout_seconds: int, stdout: str, stderr: str) -> None:\n49\t        super().__init__(f\"Child process made no progress before {timeout_seconds}s timeout\")\n50\t        self.timeout_seconds = timeout_seconds\n51\t        self.stdout = stdout\n52\t        self.stderr = stderr\n53\t\n54\t\n55\tdef utc_now() -> str:\n56\t    return datetime.now(timezone.utc).isoformat().replace(\"+00:00\", \"Z\")\n57\t\n58\t\n59\tdef canonical_hash(value: Any) -> str:\n60\t    payload = json.dumps(\n61\t        value, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False\n62\t    ).encode(\"utf-8\")\n63\t    return HASH_PREFIX + hashlib.sha256(payload).hexdigest()\n64\t\n65\t\n66\tdef bytes_hash(value: bytes) -> str:\n67\t    return HASH_PREFIX + hashlib.sha256(value).hexdigest()\n68\t\n69\t\n70\tdef atomic_write_bytes(path: Path, value: bytes) -> None:\n71\t    path.parent.mkdir(parents=True, exist_ok=True)\n72\t    temp = path.with_name(f\".t{os.getpid():x}{time.time_ns() & 0xFFFFFF:x}\")\n73\t    try:\n74\t        with temp.open(\"xb\") as stream:\n75\t            stream.write(value)\n76\t            stream.flush()\n77\t            os.fsync(stream.fileno())\n78\t        os.replace(temp, path)\n79\t    finally:\n80\t        if temp.exists():\n81\t            temp.unlink()\n82\t\n83\t\n84\tdef atomic_write_json(path: Path, value: Any) -> None:\n85\t    atomic_write_bytes(\n86\t        path,\n87\t        (json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + \"\\n\").encode(\"utf-8\"),\n88\t    )\n89\t\n90\t\n91\tdef git_index_hash(repository_root: Path) -> str:\n92\t    result = subprocess.run(\n93\t        [\"git\", \"rev-parse\", \"--git-path\", \"index\"],\n94\t        cwd=repository_root,\n95\t        capture_output=True,\n96\t        check=False,\n97\t        text=True,\n98\t        encoding=\"utf-8\",\n99\t        shell=False,\n100\t    )\n101\t    if result.returncode != 0 or not result.stdout.strip():\n102\t        raise ControlPlaneError(\"Git index path is not readable\")\n103\t    index_path = Path(result.stdout.strip())\n104\t    if not index_path.is_absolute():\n105\t        index_path = repository_root / index_path\n106\t    return bytes_hash(index_path.read_bytes() if index_path.is_file() else b\"\")\n107\t\n108\t\n109\tdef is_reparse_point(path: Path) -> bool:\n110\t    if path.is_symlink():\n111\t        return True\n112\t    attributes = getattr(path.lstat(), \"st_file_attributes\", 0)\n113\t    return bool(attributes & 0x400)\n114\t\n115\t\n116\tdef reject_reparse_escape(repository_root: Path, source: Path) -> None:\n117\t    current = source\n118\t    while current != repository_root:\n119\t        if is_reparse_point(current):\n120\t            raise ControlPlaneError(f\"Artifact path contains a reparse point: {source}\")\n121\t        current = current.parent\n122\t\n123\t\n124\tdef create_artifact_view(\n125\t    repository_root: Path,\n126\t    run_dir: Path,\n127\t    artifacts: list[dict[str, Any]],\n128\t    context_classes: dict[str, list[str]],\n129\t    authority_revision: str,\n130\t    deleted_artifacts: list[dict[str, Any]] | None = None,\n131\t) -> dict[str, Any]:\n132\t    view_root = run_dir / \"artifact-view\"\n133\t    tree_root = view_root / \"tree\"\n134\t    case_identities: dict[str, str] = {}\n135\t    entries: list[dict[str, Any]] = []\n136\t    memberships = {\n137\t        artifact: sorted(name for name, names in context_classes.items() if artifact in names)\n138\t        for artifact in (\n139\t            item[\"artifact\"] for item in [*artifacts, *(deleted_artifacts or [])]\n140\t        )\n141\t    }\n142\t    for artifact in artifacts:\n143\t        relative = artifact[\"artifact\"]\n144\t        case_identity = relative.replace(\"\\\\\", \"/\").casefold()\n145\t        previous = case_identities.get(case_identity)\n146\t        if previous is not None and previous != relative:\n147\t            raise ControlPlaneError(f\"Windows case-normalized artifact collision: {previous} vs {relative}\")\n148\t        case_identities[case_identity] = relative\n149\t        source = repository_root / relative\n150\t        reject_reparse_escape(repository_root, source)\n151\t        raw = source.read_bytes()\n152\t        if bytes_hash(raw) != artifact[\"sha256\"]:\n153\t            raise ControlPlaneError(f\"Artifact changed while creating view: {relative}\")\n154\t        snapshot = tree_root / Path(relative)\n155\t        if view_root == snapshot or view_root in snapshot.parents:\n156\t            atomic_write_bytes(snapshot, raw)\n157\t        else:\n158\t            raise ControlPlaneError(f\"Artifact snapshot escapes view: {relative}\")\n159\t        entry = {\n160\t            \"originalPath\": relative,\n161\t            \"snapshotPath\": snapshot.relative_to(run_dir).as_posix(),\n162\t            \"originalSha256\": artifact[\"sha256\"],\n163\t            \"snapshotSha256\": bytes_hash(raw),\n164\t            \"sizeBytes\": len(raw),\n165\t            \"encoding\": artifact.get(\"textEncoding\"),\n166\t            \"lineCount\": artifact.get(\"lineCount\"),\n167\t            \"fileType\": source.suffix.casefold() or \"none\",\n168\t            \"contentKind\": \"text\" if artifact.get(\"textEncoding\") else \"binary\",\n169\t            \"reparsePoint\": False,\n170\t            \"windowsCaseIdentity\": case_identity,\n171\t            \"contextClasses\": memberships[relative],\n172\t            \"sourceScopes\": [\n173\t                scope for scope in artifact.get(\"sourceScopes\", []) if isinstance(scope, str)\n174\t            ],\n175\t        }\n176\t        entries.append(entry)\n177\t    for artifact in deleted_artifacts or []:\n178\t        relative = artifact[\"artifact\"]\n179\t        case_identity = relative.replace(\"\\\\\", \"/\").casefold()\n180\t        previous = case_identities.get(case_identity)\n181\t        if previous is not None:\n182\t            raise ControlPlaneError(\n183\t                f\"Deleted artifact collides with a current Artifact View entry: {relative}\"\n184\t            )\n185\t        case_identities[case_identity] = relative\n186\t        has_source_path = isinstance(artifact.get(\"sourcePath\"), str)\n187\t        has_source_bytes = isinstance(artifact.get(\"sourceBytes\"), bytes)\n188\t        if has_source_path == has_source_bytes:\n189\t            raise ControlPlaneError(\n190\t                f\"Deleted artifact must have exactly one internal byte source: {relative}\"\n191\t            )\n192\t        raw = (\n193\t            Path(artifact[\"sourcePath\"]).resolve().read_bytes()\n194\t            if has_source_path\n195\t            else artifact[\"sourceBytes\"]\n196\t        )\n197\t        if bytes_hash(raw) != artifact[\"sha256\"]:\n198\t            raise ControlPlaneError(f\"Deleted predecessor artifact drifted: {relative}\")\n199\t        snapshot = view_root / \"deleted-tree\" / Path(relative)\n200\t        if view_root == snapshot or view_root in snapshot.parents:\n201\t            atomic_write_bytes(snapshot, raw)\n202\t        else:\n203\t            raise ControlPlaneError(f\"Deleted artifact snapshot escapes view: {relative}\")\n204\t        entries.append(\n205\t            {\n206\t                \"originalPath\": relative,\n207\t                \"snapshotPath\": snapshot.relative_to(run_dir).as_posix(),\n208\t                \"originalSha256\": artifact[\"sha256\"],\n209\t                \"snapshotSha256\": bytes_hash(raw),\n210\t                \"sizeBytes\": len(raw),\n211\t                \"encoding\": artifact.get(\"textEncoding\"),\n212\t                \"lineCount\": artifact.get(\"lineCount\"),\n213\t                \"fileType\": Path(relative).suffix.casefold() or \"none\",\n214\t                \"contentKind\": \"text\" if artifact.get(\"textEncoding\") else \"binary\",\n215\t                \"reparsePoint\": False,\n216\t                \"windowsCaseIdentity\": case_identity,\n217\t                \"contextClasses\": memberships[relative],\n218\t                \"sourceScopes\": [\n219\t                    scope for scope in artifact.get(\"sourceScopes\", [])\n220\t                    if isinstance(scope, str)\n221\t                ],\n222\t                \"sourceState\": \"deleted\",\n223\t                **(\n224\t                    {\"predecessorRun\": artifact[\"predecessorRun\"]}\n225\t                    if isinstance(artifact.get(\"predecessorRun\"), str)\n226\t                    else {}\n227\t                ),\n228\t                **(\n229\t                    {\"sourceAuthority\": artifact[\"sourceAuthority\"]}\n230\t                    if isinstance(artifact.get(\"sourceAuthority\"), dict)\n231\t                    else {}\n232\t                ),\n233\t            }\n234\t        )\n235\t    manifest = {\n236\t        \"schemaVersion\": \"artifact-view.v1\",\n237\t        \"authorityRevision\": authority_revision,\n238\t        \"createdAt\": utc_now(),\n239\t        \"entries\": entries,\n240\t    }\n241\t    manifest[\"creationHash\"] = canonical_hash(\n242\t        {\"authorityRevision\": authority_revision, \"entries\": entries}\n243\t    )\n244\t    atomic_write_json(view_root / \"manifest.json\", manifest)\n245\t    return manifest\n246\t\n247\t\n248\tdef validate_artifact_view(\n249\t    run_dir: Path,\n250\t    repository_root: Path,\n251\t    manifest: dict[str, Any],\n252\t    *,\n253\t    require_live_originals: bool = True,\n254\t) -> str:\n255\t    if manifest.get(\"schemaVersion\") != \"artifact-view.v1\":\n256\t        raise ControlPlaneError(\"Artifact View has an unsupported schemaVersion\")\n257\t    entries = manifest.get(\"entries\")\n258\t    if not isinstance(entries, list) or not entries:\n259\t        raise ControlPlaneError(\"Artifact View contains no entries\")\n260\t    expected_creation = canonical_hash(\n261\t        {\"authorityRevision\": manifest.get(\"authorityRevision\"), \"entries\": entries}\n262\t    )\n263\t    if manifest.get(\"creationHash\") != expected_creation:\n264\t        raise ControlPlaneError(\"Artifact View creationHash is invalid\")\n265\t    for entry in entries:\n266\t        original_path = entry.get(\"originalPath\")\n267\t        snapshot_path = entry.get(\"snapshotPath\")\n268\t        if (\n269\t            not isinstance(original_path, str)\n270\t            or not isinstance(snapshot_path, str)\n271\t            or \"\\\\\" in original_path\n272\t            or \"\\\\\" in snapshot_path\n273\t            or Path(original_path).is_absolute()\n274\t            or Path(snapshot_path).is_absolute()\n275\t            or \"..\" in PurePosixPath(original_path).parts\n276\t            or \"..\" in PurePosixPath(snapshot_path).parts\n277\t        ):\n278\t            raise ControlPlaneError(\"Artifact View entry escapes its bound root\")\n279\t        original = (repository_root / original_path).resolve()\n280\t        snapshot = (run_dir / snapshot_path).resolve()\n281\t        try:\n282\t            original.relative_to(repository_root.resolve())\n283\t            snapshot.relative_to((run_dir / \"artifact-view\").resolve())\n284\t        except ValueError as exc:\n285\t            raise ControlPlaneError(\"Artifact View entry escapes its bound root\") from exc\n286\t        if require_live_originals:\n287\t            if entry.get(\"sourceState\") == \"deleted\":\n288\t                if original.exists():\n289\t                    raise ControlPlaneError(\n290\t                        f\"Deleted artifact reappeared: {entry['originalPath']}\"\n291\t                    )\n292\t            elif not original.is_file() or bytes_hash(original.read_bytes()) != entry[\"originalSha256\"]:\n293\t                raise ControlPlaneError(f\"Live artifact drifted: {entry['originalPath']}\")\n294\t        if not snapshot.is_file() or bytes_hash(snapshot.read_bytes()) != entry[\"snapshotSha256\"]:\n295\t            raise ControlPlaneError(f\"Artifact View drifted: {entry['snapshotPath']}\")\n296\t        if entry[\"originalSha256\"] != entry[\"snapshotSha256\"]:\n297\t            raise ControlPlaneError(f\"Artifact View bytes differ: {entry['originalPath']}\")\n298\t    return bytes_hash((run_dir / \"artifact-view\" / \"manifest.json\").read_bytes())\n299\t\n300\t\n301\tdef _process_creation_identity(pid: int) -> str | None:\n302\t    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n303\t        return None\n304\t    if os.name == \"nt\":\n305\t        process_query_limited_information = 0x1000\n306\t        still_active = 259\n307\t\n308\t        class FileTime(ctypes.Structure):\n309\t            _fields_ = [(\"low\", ctypes.c_ulong), (\"high\", ctypes.c_ulong)]\n310\t\n311\t        kernel32 = ctypes.WinDLL(\"kernel32\", use_last_error=True)\n312\t        kernel32.OpenProcess.argtypes = [ctypes.c_ulong, ctypes.c_int, ctypes.c_ulong]\n313\t        kernel32.OpenProcess.restype = ctypes.c_void_p\n314\t        kernel32.GetExitCodeProcess.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_ulong)]\n315\t        kernel32.GetExitCodeProcess.restype = ctypes.c_int\n316\t        kernel32.GetProcessTimes.argtypes = [\n317\t            ctypes.c_void_p,\n318\t            ctypes.POINTER(FileTime),\n319\t            ctypes.POINTER(FileTime),\n320\t            ctypes.POINTER(FileTime),\n321\t            ctypes.POINTER(FileTime),\n322\t        ]\n323\t        kernel32.GetProcessTimes.restype = ctypes.c_int\n324\t        kernel32.CloseHandle.argtypes = [ctypes.c_void_p]\n325\t        kernel32.CloseHandle.restype = ctypes.c_int\n326\t        handle = kernel32.OpenProcess(process_query_limited_information, False, pid)\n327\t        if not handle:\n328\t            return None\n329\t        try:\n330\t            exit_code = ctypes.c_ulong()\n331\t            if not kernel32.GetExitCodeProcess(handle, ctypes.byref(exit_code)):\n332\t                return None\n333\t            if exit_code.value != still_active:\n334\t                return None\n335\t            creation = FileTime()\n336\t            exit_time = FileTime()\n337\t            kernel = FileTime()\n338\t            user = FileTime()\n339\t            if not kernel32.GetProcessTimes(\n340\t                handle,\n341\t                ctypes.byref(creation),\n342\t                ctypes.byref(exit_time),\n343\t                ctypes.byref(kernel),\n344\t                ctypes.byref(user),\n345\t            ):\n346\t                return None\n347\t            return f\"windows-filetime:{(creation.high << 32) | creation.low}\"\n348\t        finally:\n349\t            kernel32.CloseHandle(handle)\n350\t    proc_stat = Path(f\"/proc/{pid}/stat\")\n351\t    if proc_stat.is_file():\n352\t        try:\n353\t            stat = proc_stat.read_text(encoding=\"ascii\")\n354\t            fields_after_comm = stat[stat.rfind(\")\") + 2:].split()\n355\t            return f\"linux-starttime:{fields_after_comm[19]}\"\n356\t        except (OSError, UnicodeError, IndexError, ValueError):\n357\t            return None\n358\t    return None\n359\t\n360\t\n361\tdef _event_lock_is_stale(lock: Path) -> bool:\n362\t    try:\n363\t        age_seconds = time.time() - lock.stat().st_mtime\n364\t    except OSError:\n365\t        return False\n366\t    try:\n367\t        owner = json.loads(lock.read_text(encoding=\"utf-8\"))\n368\t    except (OSError, UnicodeError, ValueError):\n369\t        return age_seconds > 1\n370\t    pid = owner.get(\"pid\") if isinstance(owner, dict) else None\n371\t    identity = owner.get(\"processIdentity\") if isinstance(owner, dict) else None\n372\t    if isinstance(owner, dict) and owner.get(\"phase\") == \"committed\":\n373\t        return True\n374\t    if not isinstance(pid, int) or not isinstance(identity, str):\n375\t        return age_seconds > 1\n376\t    return _process_creation_identity(pid) != identity\n377\t\n378\t\n379\tdef _write_event_lock_owner(descriptor: int, owner: dict[str, Any]) -> None:\n380\t    payload = json.dumps(\n381\t        owner, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\"), allow_nan=False\n382\t    ).encode(\"utf-8\")\n383\t    os.lseek(descriptor, 0, os.SEEK_SET)\n384\t    os.ftruncate(descriptor, 0)\n385\t    os.write(descriptor, payload)\n386\t    os.fsync(descriptor)\n387\t\n388\t\n389\tdef append_process_event(run_dir: Path, event: dict[str, Any]) -> None:\n390\t    path = run_dir / \"process-events.jsonl\"\n391\t    lock = run_dir / \".process-events.lock\"\n392\t    deadline = time.monotonic() + 15\n393\t    descriptor: int | None = None\n394\t    token = secrets.token_hex(16)\n395\t    while descriptor is None:\n396\t        try:\n397\t            descriptor = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)\n398\t            try:\n399\t                owner = {\n400\t                    \"pid\": os.getpid(),\n401\t                    \"processIdentity\": _process_creation_identity(os.getpid()),\n402\t                    \"token\": token,\n403\t                    \"createdAt\": utc_now(),\n404\t                    \"phase\": \"acquired\",\n405\t                }\n406\t                _write_event_lock_owner(descriptor, owner)\n407\t            except Exception:\n408\t                os.close(descriptor)\n409\t                descriptor = None\n410\t                lock.unlink(missing_ok=True)\n411\t                raise\n412\t        except FileExistsError:\n413\t            if _event_lock_is_stale(lock):\n414\t                try:\n415\t                    lock.unlink()\n416\t                except OSError:\n417\t                    pass\n418\t                continue\n419\t            if time.monotonic() >= deadline:\n420\t                raise ControlPlaneError(\"Timed out waiting for process event lock\")\n421\t            time.sleep(0.05)\n422\t    try:\n423\t        event = {\"schemaVersion\": \"bootstrap-process-event.v1\", **event}\n424\t        line = json.dumps(event, ensure_ascii=False, sort_keys=True, allow_nan=False) + \"\\n\"\n425\t        with path.open(\"a\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n426\t            stream.write(line)\n427\t            stream.flush()\n428\t            os.fsync(stream.fileno())\n429\t        owner[\"phase\"] = \"committed\"\n430\t        _write_event_lock_owner(descriptor, owner)\n431\t    finally:\n432\t        os.close(descriptor)\n433\t        for _attempt in range(40):\n434\t            try:\n435\t                current_owner = json.loads(lock.read_text(encoding=\"utf-8\"))\n436\t            except (OSError, UnicodeError, ValueError):\n437\t                break\n438\t            if current_owner.get(\"token\") != token:\n439\t                break\n440\t            try:\n441\t                lock.unlink(missing_ok=True)\n442\t                break\n443\t            except PermissionError:\n444\t                time.sleep(0.05)\n445\t\n446\t\n447\tdef read_process_events(run_dir: Path) -> list[dict[str, Any]]:\n448\t    path = run_dir / \"process-events.jsonl\"\n449\t    if not path.is_file():\n450\t        return []\n451\t    events = []\n452\t    for number, line in enumerate(path.read_text(encoding=\"utf-8\").splitlines(), start=1):\n453\t        try:\n454\t            value = json.loads(line)\n455\t        except ValueError as exc:\n456\t            raise ControlPlaneError(f\"Invalid process event at line {number}: {exc}\") from exc\n457\t        if value.get(\"schemaVersion\") != \"bootstrap-process-event.v1\":\n458\t            raise ControlPlaneError(f\"Invalid process event schema at line {number}\")\n459\t        events.append(value)\n460\t    return events\n461\t\n462\t\n463\tdef active_attempts(events: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:\n464\t    active: dict[str, dict[str, Any]] = {}\n465\t    for event in events:\n466\t        attempt_id = event.get(\"attemptId\")\n467\t        if not isinstance(attempt_id, str):\n468\t            continue\n469\t        if event.get(\"eventType\") in {\"attempt-reserved\", \"attempt-started\"}:\n470\t            active[attempt_id] = event\n471\t        elif event.get(\"eventType\") in TERMINAL_EVENT_TYPES:\n472\t            active.pop(attempt_id, None)\n473\t    return active\n474\t\n475\t\n476\tdef child_environment() -> tuple[dict[str, str], dict[str, str]]:\n477\t    child: dict[str, str] = {}\n478\t    evidence: dict[str, str] = {}\n479\t    for name in ENVIRONMENT_ALLOWLIST:\n480\t        value = os.environ.get(name)\n481\t        if value is None:\n482\t            continue\n483\t        child[name] = value\n484\t        evidence[name] = bytes_hash(value.encode(\"utf-8\")) if name.endswith(\"KEY\") else value\n485\t    return child, evidence\n486\t\n487\t\n488\tdef render_codex_command(\n489\t    codex_command: str,\n490\t    model: str,\n491\t    reasoning_effort: str,\n492\t    sandbox: str,\n493\t    output_path: Path,\n494\t) -> list[str]:\n495\t    if reasoning_effort not in {\"medium\", \"high\", \"max\"}:\n496\t        raise ControlPlaneError(\"reasoning_effort violates its typed placeholder\")\n497\t    if sandbox not in {\"read-only\", \"workspace-write\"}:\n498\t        raise ControlPlaneError(\"sandbox violates its typed placeholder\")\n499\t    if not model or re.fullmatch(r\"[A-Za-z0-9._-]+\", model) is None:\n500\t        raise ControlPlaneError(\"model violates its typed placeholder\")\n\n(Partial: lines 1-500 of 534 shown. Continue with offset=501.)"}],"structured_content":null},"error":null,"status":"completed"}}
