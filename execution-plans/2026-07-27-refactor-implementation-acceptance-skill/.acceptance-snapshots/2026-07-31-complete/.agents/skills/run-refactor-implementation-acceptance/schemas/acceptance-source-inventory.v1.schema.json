{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance Source Inventory",
  "type": "object",
  "required": ["schemaVersion", "partitions", "overallCompleteness"],
  "properties": {
    "schemaVersion": {"const": "acceptance-source-inventory.v1"},
    "overallCompleteness": {"enum": ["deterministic_complete", "semantically_attested_complete", "candidate", "incomplete"]},
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["partition_id", "source_refs", "extraction_mode", "completeness"],
        "properties": {
          "partition_id": {"type": "string", "minLength": 1},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}},
          "extraction_mode": {"enum": ["registry_backed", "parser_backed", "semantic_candidate"]},
          "completeness": {"enum": ["deterministic_complete", "semantically_attested_complete", "candidate", "incomplete"]},
          "attestationHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "attestationScopeHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    }
  }
}
