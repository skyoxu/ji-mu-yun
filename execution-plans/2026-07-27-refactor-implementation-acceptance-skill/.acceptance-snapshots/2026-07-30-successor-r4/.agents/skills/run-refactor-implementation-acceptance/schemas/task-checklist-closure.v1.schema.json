{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Checklist Closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "acceptanceRunId", "candidateContentManifestHash", "sources", "items", "requiredItemCount", "checkedRequiredItemCount", "verifiedRequiredItemCount", "status", "authorizes"],
  "properties": {
    "schemaVersion": {"const": "task-checklist-closure.v1"},
    "status": {"enum": ["passed", "failed", "incomplete", "not_applicable", "stale"]},
    "sources": {"type": "array", "minItems": 1},
    "items": {"type": "array", "minItems": 1},
    "authorizes": {"const": []}
  }
}
