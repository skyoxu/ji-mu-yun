{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.backend-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "slice_id", "run_id", "attempt_id", "stage", "stage_binding_id", "actor", "capsule_ref", "goal", "allowed_command_ids", "request_payload_hash", "raw_body_persisted", "contains_sensitive_data", "previous_attempt_id"],
  "properties": {
    "schema_version": {"const": "jimuyun.backend-request.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "pattern": "^RMAP-S[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "pattern": "^ATTEMPT-[0-9]{3,}$"},
    "stage": {"enum": ["red", "green", "refactor"]},
    "stage_binding_id": {"type": "string", "pattern": "^STAGE-(RED|GREEN|REFACTOR)$"},
    "actor": {"$ref": "#/$defs/actor"},
    "capsule_ref": {"$ref": "#/$defs/artifactRef"},
    "goal": {"enum": ["observe-red", "make-red-green", "preserve-green-refactor"]},
    "allowed_command_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "request_payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "raw_body_persisted": {"const": false},
    "contains_sensitive_data": {"const": false},
    "previous_attempt_id": {"type": ["string", "null"], "pattern": "^ATTEMPT-[0-9]{3,}$"}
  },
  "$defs": {
    "actor": {"type": "object", "additionalProperties": false, "required": ["role", "backend_protocol_version", "actor_instance_id", "identity_authoritative"], "properties": {"role": {"const": "slice-capsule-executor"}, "backend_protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}, "actor_instance_id": {"type": "string", "minLength": 1}, "identity_authoritative": {"const": false}}},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["path_type", "path", "sha256"], "properties": {"path_type": {"enum": ["repo_path", "plan_path", "run_path"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
  }
}
