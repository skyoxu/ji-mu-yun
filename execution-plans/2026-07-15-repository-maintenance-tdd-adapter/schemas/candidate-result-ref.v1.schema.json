{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.candidate-result-ref.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slice_id",
    "run_id",
    "path",
    "sha256",
    "candidate_hash",
    "predicate",
    "superseded"
  ],
  "properties": {
    "schema_version": {"const": "jimuyun.candidate-result-ref.v1"},
    "slice_id": {"const": "RMAP-S6"},
    "run_id": {"type": "string", "minLength": 1},
    "path": {
      "type": "string",
      "pattern": "^logs/tdd-adapter/[^/]+/RMAP-S6/[^/]+/candidate-result\\.json$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "predicate": {"const": "implementation-candidate"},
    "superseded": {"const": false}
  }
}
