{
  "schema_version": "rmap.command-registry.v1",
  "shell": false,
  "environment_allowlist": ["PYTHONDONTWRITEBYTECODE", "GODOT_BIN"],
  "secret_values_allowed": false,
  "placeholder_types": ["repo_path", "plan_path", "run_path", "slice_id", "literal_enum"],
  "commands": [
    {
      "id": "rmap-plan-validate",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--predicate", "plan-ready"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 120,
      "expected_exit": "zero"
    },
    {
      "id": "rmap-validator-tests",
      "executable": "py",
      "argv": ["-3", "-m", "unittest", "discover", "-s", {"type": "plan_path", "value": "tools/tests"}, "-p", "test_*.py", "-v"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 120,
      "expected_exit": "zero"
    },
    {
      "id": "rmap-s0-slice-validate",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--predicate", "slice-ready", "--slice-id", "RMAP-S0"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 120,
      "expected_exit": "zero",
      "declared_predicate": "slice-ready",
      "slice_id": "RMAP-S0"
    },
    {
      "id": "rmap-s1-slice-validate",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--predicate", "slice-ready", "--slice-id", "RMAP-S1"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 180,
      "expected_exit": "zero",
      "declared_predicate": "slice-ready",
      "slice_id": "RMAP-S1"
    },
    {
      "id": "rmap-s2-candidate-validate",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--predicate", "implementation-candidate", "--slice-id", "RMAP-S2"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 180,
      "expected_exit": "zero",
      "declared_predicate": "implementation-candidate",
      "slice_id": "RMAP-S2"
    },
    {
      "id": "rmap-s3-slice-validate",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--predicate", "slice-ready", "--slice-id", "RMAP-S3"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 180,
      "expected_exit": "zero",
      "declared_predicate": "slice-ready",
      "slice_id": "RMAP-S3"
    },
    {
      "id": "rmap-s4-slice-validate",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--predicate", "slice-ready", "--slice-id", "RMAP-S4"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 180,
      "expected_exit": "zero",
      "declared_predicate": "slice-ready",
      "slice_id": "RMAP-S4"
    },
    {
      "id": "rmap-s5-slice-validate",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--predicate", "slice-ready", "--slice-id", "RMAP-S5"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 180,
      "expected_exit": "zero",
      "declared_predicate": "slice-ready",
      "slice_id": "RMAP-S5"
    },
    {
      "id": "rmap-s6-candidate-validate",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--predicate", "implementation-candidate", "--slice-id", "RMAP-S6", "--candidate-result", {"type": "run_path", "value": "tdd-adapter/<plan-id>/<slice-id>/<run-id>/candidate-result.json"}, "--bootstrap-run", {"type": "run_path", "value": "ci/<date>/<bootstrap-run>"}],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 180,
      "expected_exit": "zero",
      "declared_predicate": "implementation-candidate",
      "slice_id": "RMAP-S6"
    },
    {
      "id": "rmap-s7-acceptance-validate",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--predicate", "implementation-accepted", "--slice-id", "RMAP-S7", "--candidate-result", {"type": "run_path", "value": "tdd-adapter/<plan-id>/<slice-id>/<run-id>/candidate-result.json"}, "--bootstrap-run", {"type": "run_path", "value": "ci/<date>/<bootstrap-run>"}],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 180,
      "expected_exit": "zero",
      "declared_predicate": "implementation-accepted",
      "slice_id": "RMAP-S7"
    },
    {
      "id": "rmap-observe-shell-red",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--fixture", "shell-true"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 60,
      "expected_exit": "nonzero",
      "expected_failure_ids": ["RMAP-CMD-SHELL"]
    },
    {
      "id": "rmap-observe-ownership-red",
      "executable": "py",
      "argv": ["-3", {"type": "plan_path", "value": "tools/validate_all.py"}, "--fixture", "duplicate-ownership"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 60,
      "expected_exit": "nonzero",
      "expected_failure_ids": ["RMAP-OWNERSHIP-DUPLICATE"]
    },
    {
      "id": "rmap-adapter-tests",
      "executable": "py",
      "argv": ["-3", "-m", "unittest", "discover", "-s", ".agents/skills/quick-dev-tdd-adapter/tools/tests", "-p", "test_*.py", "-v"],
      "cwd": {"type": "repo_path", "value": "."},
      "timeout_seconds": 180,
      "expected_exit": "zero"
    }
  ]
}
