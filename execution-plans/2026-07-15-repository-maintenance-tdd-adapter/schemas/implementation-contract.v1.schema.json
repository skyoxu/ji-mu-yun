{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.implementation-contract.v1",
  "title": "Ji Mu Yun Implementation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "source_revision", "protocol_version", "authority", "ownership", "command_registry", "backend", "recovery", "drift_policy", "acceptance_policy", "shadow_backfills", "slices"],
  "properties": {
    "schema_version": {"const": "jimuyun.implementation-contract.v1"},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "source_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "requirements", "coverage", "deltas", "source_hashes"],
      "properties": {
        "index": {"type": "string"},
        "requirements": {"type": "string"},
        "coverage": {"type": "string"},
        "deltas": {"type": "string"},
        "source_hashes": {"type": "object"}
      }
    },
    "ownership": {"type": "object"},
    "command_registry": {"type": "string", "pattern": "^schemas/[a-z0-9.-]+\\.json$"},
    "backend": {"type": "object"},
    "recovery": {"type": "object"},
    "drift_policy": {"type": "object"},
    "acceptance_policy": {"type": "object"},
    "shadow_backfills": {"type": "array"},
    "slices": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
