{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.artifact-proof.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_path", "artifact_kind", "proof_scope", "finding_ids", "dimension_verdicts", "schema_producer_authority", "immutable_identity", "source_of_truth_derivation", "independent_recomputation", "staleness_propagation", "recovery_supersession", "consumer_authorization_boundary"],
  "properties": {
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_kind": {"enum": ["normative", "projection", "evidence", "lineage", "validator"]},
    "proof_scope": {"enum": ["static-contract", "authorization-participating", "non-authorizing-derived-view"]},
    "finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dimension_verdicts": {"$ref": "#/$defs/dimensionVerdicts"},
    "schema_producer_authority": {"$ref": "#/$defs/producer"},
    "immutable_identity": {"$ref": "#/$defs/identity"},
    "source_of_truth_derivation": {"$ref": "#/$defs/derivation"},
    "independent_recomputation": {"$ref": "#/$defs/recomputation"},
    "staleness_propagation": {"$ref": "#/$defs/staleness"},
    "recovery_supersession": {"$ref": "#/$defs/recovery"},
    "consumer_authorization_boundary": {"$ref": "#/$defs/consumer"}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nullableString": {"type": ["string", "null"]},
    "passVerdict": {"type": "object", "additionalProperties": false, "required": ["status", "evidence_rule_ids"], "properties": {"status": {"const": "PASS"}, "evidence_rule_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "notApplicableVerdict": {"type": "object", "additionalProperties": false, "required": ["status", "reason_code", "reason"], "properties": {"status": {"const": "N/A"}, "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "reason": {"type": "string", "minLength": 12}}},
    "dimensionVerdict": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["PASS", "N/A"]}, "evidence_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "reason": {"type": "string", "minLength": 12}}},
    "dimensionVerdicts": {"type": "object", "additionalProperties": false, "required": ["schema_producer_authority", "immutable_identity", "source_of_truth_derivation", "independent_recomputation", "staleness_propagation", "recovery_supersession", "consumer_authorization_boundary"], "properties": {"schema_producer_authority": {"$ref": "#/$defs/dimensionVerdict"}, "immutable_identity": {"$ref": "#/$defs/dimensionVerdict"}, "source_of_truth_derivation": {"$ref": "#/$defs/dimensionVerdict"}, "independent_recomputation": {"$ref": "#/$defs/dimensionVerdict"}, "staleness_propagation": {"$ref": "#/$defs/dimensionVerdict"}, "recovery_supersession": {"$ref": "#/$defs/dimensionVerdict"}, "consumer_authorization_boundary": {"$ref": "#/$defs/dimensionVerdict"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["authority_path", "authority_category", "authority_sha256", "producer_kind", "generator_path", "generator_sha256"], "properties": {"authority_path": {"type": "string", "minLength": 1}, "authority_category": {"type": "string", "minLength": 1}, "authority_sha256": {"type": "string", "minLength": 1}, "producer_kind": {"enum": ["manual-authority", "generated-projection", "authorized-event"]}, "generator_path": {"$ref": "#/$defs/nullableString"}, "generator_sha256": {"$ref": "#/$defs/nullableString"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["mode", "algorithm", "artifact_sha256", "authority_revision", "manifest_path"], "properties": {"mode": {"enum": ["authority-root", "semantic-root-policy", "pinned-bytes", "derived-projection"]}, "algorithm": {"enum": ["sha256-bytes", "vdd-root-policy-v1"]}, "artifact_sha256": {"$ref": "#/$defs/nullableString"}, "authority_revision": {"type": "string", "minLength": 1}, "manifest_path": {"const": "schemas/authority-manifest.v1.json"}}},
    "derivationRule": {"type": "object", "additionalProperties": false, "required": ["source", "source_sha256", "field", "target_field", "derivation"], "properties": {"source": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/nullableString"}, "field": {"type": "string", "minLength": 1}, "target_field": {"type": "string", "minLength": 1}, "derivation": {"enum": ["authority-derived", "authoritative-bytes", "exact-projection", "hash-bound-reference", "external-hash-pin", "semantic-policy-reference"]}}},
    "derivation": {"type": "object", "additionalProperties": false, "required": ["rules"], "properties": {"rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/derivationRule"}}}},
    "recomputation": {"type": "object", "additionalProperties": false, "required": ["rule_id", "validator_path", "validator_sha256", "callable", "negative_test_path", "negative_test_sha256", "expected_failure_ids"], "properties": {"rule_id": {"type": "string", "minLength": 1}, "validator_path": {"type": "string", "minLength": 1}, "validator_sha256": {"type": "string", "minLength": 1}, "callable": {"type": "string", "minLength": 1}, "negative_test_path": {"type": "string", "minLength": 1}, "negative_test_sha256": {"type": "string", "minLength": 1}, "expected_failure_ids": {"$ref": "#/$defs/strings"}}},
    "staleness": {"type": "object", "additionalProperties": false, "required": ["inputs", "invalidates", "regeneration_command_id", "revalidation_command_id"], "properties": {"inputs": {"type": "array", "items": {"$ref": "#/$defs/derivationRule"}}, "invalidates": {"type": "array", "items": {"type": "string", "minLength": 1}}, "regeneration_command_id": {"type": "string", "minLength": 1}, "revalidation_command_id": {"type": "string", "minLength": 1}}},
    "recovery": {"type": "object", "additionalProperties": false, "required": ["history_policy", "schema_path", "lineage_fields", "predecessor_policy", "lifecycle_status", "predecessor_sha256"], "properties": {"history_policy": {"const": "append-only-successor-no-rewrite"}, "schema_path": {"type": "string", "minLength": 1}, "lineage_fields": {"type": "array", "items": {"type": "string", "minLength": 1}}, "predecessor_policy": {"type": "string", "minLength": 1}, "lifecycle_status": {"enum": ["new", "unchanged", "supersedes"]}, "predecessor_sha256": {"$ref": "#/$defs/nullableString"}}},
    "consumer": {"type": "object", "additionalProperties": false, "required": ["consumers", "predicate", "authorizes", "does_not_authorize"], "properties": {"consumers": {"type": "array", "items": {"type": "string", "minLength": 1}}, "predicate": {"type": "string", "minLength": 1}, "authorizes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "does_not_authorize": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
  }
}
