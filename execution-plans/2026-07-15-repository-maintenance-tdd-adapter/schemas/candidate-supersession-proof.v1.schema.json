{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.candidate-supersession-proof.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_run_id", "recovery_state_ref", "event_log_ref", "successor_scan_root", "final_event_hash", "active_run_id"],
  "properties": {
    "schema_version": {"const": "jimuyun.candidate-supersession-proof.v1"},
    "candidate_run_id": {"type": "string", "minLength": 1},
    "recovery_state_ref": {"$ref": "#/$defs/artifactRef"},
    "event_log_ref": {"$ref": "#/$defs/artifactRef"},
    "successor_scan_root": {"const": "logs/tdd-adapter/repository-maintenance-tdd-adapter/RMAP-S6"},
    "final_event_hash": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "active_run_id": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
