{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jimuyun.baseline-file-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "slice_id", "run_id", "files", "root_hash"],
  "properties": {
    "schema_version": {"const": "jimuyun.baseline-file-manifest.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "pattern": "^RMAP-S[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "snapshot_ref"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
          "snapshot_ref": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["path_type", "path", "sha256"],
            "properties": {
              "path_type": {"const": "run_path"},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "root_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
