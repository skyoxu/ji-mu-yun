          "rule_id": {
            "minLength": 1,
            "type": "string"
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "symbol": {
            "minLength": 1,
            "type": "string"
          }
        },
