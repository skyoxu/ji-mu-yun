{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Review Policy Pack",
  "type": "object",
  "required": ["schemaVersion", "policyId", "policyRevision", "targetDomain", "authorityRefs", "checks"],
  "properties": {
    "schemaVersion": {"const": "code-review-policy-pack.v1"},
    "policyId": {"enum": ["phase-service-code-review", "toolchain-code-review"]},
    "targetDomain": {"enum": ["phase_service", "toolchain"]},
    "pathRules": {"type": "object"}
  }
}
