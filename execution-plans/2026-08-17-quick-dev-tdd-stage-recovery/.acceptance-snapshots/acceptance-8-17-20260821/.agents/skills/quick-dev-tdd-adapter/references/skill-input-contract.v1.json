  "budget_basis": {"path": ".agents/skills/quick-dev-tdd-adapter/references/skill-input-budget.paged-v1.json", "sha256": "sha256:da452a9a1ff6ad9686251e582562b8e0ef0c13b6298e1ae7514d6d775e721118"},
  "sensitivity_policy": "deny-credential-values",
  "redaction_profile": "credential-values-v1",
  "forbidden_sources": ["logs-as-recovery-source"],
  "semantic_acceptance": "all-required-inputs-are-sufficient"
}
