<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GeneratedWorkspaceExcludes>artifacts/**;.verify/**;logs/**;obj_verify/**;bin_verify/**;temp-obj/**;buildcache/**;.codex-temp/**;.codex-test/**;artifacts\**;.verify\**;logs\**;obj_verify\**;bin_verify\**;temp-obj\**;buildcache\**;.codex-temp\**;.codex-test\**;**/artifacts/**;**/.verify/**;**/logs/**;**/obj_verify/**;**/bin_verify/**;**/temp-obj/**;**/buildcache/**;**/.codex-temp/**;**/.codex-test/**;**\artifacts\**;**\.verify\**;**\logs\**;**\obj_verify\**;**\bin_verify\**;**\temp-obj\**;**\buildcache\**;**\.codex-temp\**;**\.codex-test\**</GeneratedWorkspaceExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(GeneratedWorkspaceExcludes);obj/**;bin/**;buildcache/**;obj\**;bin\**;buildcache\**;**/obj/**;**/bin/**;**/buildcache/**;**\obj\**;**\bin\**;**\buildcache\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="$(GeneratedWorkspaceExcludes)" />
    <EmbeddedResource Remove="$(GeneratedWorkspaceExcludes)" />
    <None Remove="$(GeneratedWorkspaceExcludes)" />
  </ItemGroup>
</Project>
