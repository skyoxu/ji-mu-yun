  "semanticFamilies": [
    {
      "familyId": "unit_scale",
      "displayName": "Unit scale",
      "scope": "Godot project units, 2D pixels/control sizes, TileMap cells, and 3D meter-like project units must not be conflated.",
      "requiredDeclarations": [
        "unit scale source",
        "2D/3D scope",
        "conversion rule when mixed"
      ],
      "blockingExamples": [
        "hard-coded world scale without project source"
      ]
    },
    {
      "familyId": "coordinate_spaces",
      "displayName": "Coordinate spaces",
      "scope": "Screen, viewport, Control local, CanvasLayer, Node2D local/global, Camera2D world, TileMap cell, and 3D world coordinates must be named before conversion.",
      "requiredDeclarations": [
        "source coordinate space",
        "target coordinate space",
        "conversion owner"
      ],
      "blockingExamples": [
        "mixed screen/world/cell coordinates without conversion path"
      ]
    },
    {
      "familyId": "viewport_resolution",
      "displayName": "Viewport and resolution",
      "scope": "Window size, project stretch settings, viewport size, UI logical size, and screenshot dimensions are distinct unless a route records a rule.",
      "requiredDeclarations": [
        "viewport mode",
        "stretch/aspect policy",
        "evidence dimensions"
      ],
      "blockingExamples": [
        "hard-coded screen size without viewport mode"
      ]
    },
    {
      "familyId": "input_constants",
      "displayName": "Input constants",
      "scope": "InputMap actions, Godot enums, named constants, or route schema enums are required before accepting input behavior.",
      "requiredDeclarations": [
        "input action or named constant",
        "device scope",
        "fallback behavior"
      ],
      "blockingExamples": [
        "numeric mouse button or key code without named source"
      ]
    },
    {
      "familyId": "physics_collision",
      "displayName": "Physics and collision",
      "scope": "Movement and interaction routes must declare body type, layer/mask ownership, signal ownership, and raycast coordinate space.",
      "requiredDeclarations": [
        "body type",
        "layer/mask owner",
        "signal/raycast owner"
      ],
      "blockingExamples": [
        "collision layer number without fixture or profile"
      ]
    },
    {
      "familyId": "camera_projection",
      "displayName": "Camera and projection",
      "scope": "Camera owner, zoom/FOV, projection, and screen/world conversion must be declared for camera-dependent interaction or evidence.",
      "requiredDeclarations": [
        "camera owner",
        "zoom or FOV",
        "screen/world conversion"
      ],
      "blockingExamples": [
        "click/drag hit testing without camera state"
      ]
    },
    {
      "familyId": "third_person_camera",
      "displayName": "Third-person camera",
      "scope": "Third-person gameplay should use a repo-owned camera rig/profile before adding gameplay-specific camera behavior.",
      "requiredDeclarations": [
        "rig/profile source",
        "target/camera/spring-arm paths",
        "yaw/pitch/collision semantics"
      ],
      "blockingExamples": [
        "duplicated orbit math while shared rig is required"
      ]
    },
    {
      "familyId": "tilemap_map",
      "displayName": "TileMap and map drawing",
      "scope": "Tile size, cell coordinate source, local/world conversion, and TileSet collision/navigation ownership must be declared.",
      "requiredDeclarations": [
        "tile size",
        "cell/world conversion",
        "TileSet ownership"
      ],
      "blockingExamples": [
        "map route using cells without tile source"
      ]
    },
    {
      "familyId": "geometry_size_measurement",
      "displayName": "Geometry and size measurement",
      "scope": "Built-in primitives, imported meshes, generated meshes, collision shapes, and hit zones require measured or documented dimensions.",
      "requiredDeclarations": [
        "AABB/import/shape/source size",
        "owner resource",
        "fallback behavior"
      ],
      "blockingExamples": [
        "guessed mesh or collision bounds"
      ]
    },
    {
      "familyId": "rendering_material_resources",
      "displayName": "Rendering and material resources",
      "scope": "Material, shader, texture, and generated visual resource paths must come from repo files, generated artifacts, import metadata, or approved profiles.",
      "requiredDeclarations": [
        "material profile",
        "resource path source",
        "validation evidence"
      ],
      "blockingExamples": [
        "invented shader, texture, or material path"
      ]
    }
  ],
  "viewportModes": [
    {
      "modeId": "fixed_design_resolution",
      "displayName": "Fixed design resolution",
      "useWhen": "The GDD or style contract names a target resolution or fixed-format board/map/tool surface.",
      "requiredEvidence": [
        "design resolution",
        "stretch/aspect policy",
        "target-size screenshot or layout evidence",
        "overflow behavior"
      ]
    },
    {
      "modeId": "responsive_control_layout",
      "displayName": "Responsive Control layout",
      "useWhen": "UI is built from Godot Control nodes, containers, anchors, and theme resources.",
      "requiredEvidence": [
        "anchor/container policy",
        "minimum size",
        "font/theme scale",
        "overflow policy",
        "non-target-size validation"
      ]
    },
    {
      "modeId": "camera_world_scaled_view",
      "displayName": "Camera/world-scaled view",
      "useWhen": "Gameplay interaction depends on Camera2D/Camera3D, zoom, world units, or world-space UI.",
      "requiredEvidence": [
        "camera owner",
        "zoom or FOV",
        "world-to-screen conversion",
        "input hit-test conversion",
        "camera-state evidence"
      ]
    },
    {
      "modeId": "tilemap_grid_scaled_view",
      "displayName": "TileMap/grid-scaled view",
      "useWhen": "The route paints or reads cells, terrain, route maps, minimaps, or grid gameplay.",
      "requiredEvidence": [
        "tile size",
        "cell/world conversion",
        "TileSet collision/navigation ownership",
        "map validation evidence"
      ]
    },
    {
      "modeId": "viewport_custom_drawing",
      "displayName": "Viewport/custom drawing",
      "useWhen": "The route uses _draw, Line2D, Polygon2D, SubViewport, shaders, or procedural visual evidence.",
      "requiredEvidence": [
        "viewport size source",
        "redraw trigger",
        "coordinate space",
        "interactive hit testing when applicable",
        "screenshot or canvas-pixel evidence"
      ]
    }
  ],
