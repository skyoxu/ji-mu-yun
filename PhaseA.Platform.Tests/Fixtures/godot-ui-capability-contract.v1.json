  "injectionPoints": [
    {
      "routeId": "gdd-question-form",
      "summary": "Optionally asks for UI-heavy flow hints without suppressing default UI classification.",
      "requiredFields": [
        "ui_hints_optional",
        "default_ui_classification_preserved"
      ]
    },
    {
      "routeId": "scene-route-confirmation",
      "summary": "Declares expected player-facing UI surfaces or no_ui_needed per confirmed scene.",
      "requiredFields": [
        "scene_ui_surface_expectations",
        "no_ui_needed_rationale"
      ]
    },
    {
      "routeId": "gdd-document-generation",
      "summary": "Carries UI, HUD, input, drawing, camera, animation, procedural, and rendering implications into generated GDD.",
      "requiredFields": [
        "ui_implications",
        "input_feedback_implications"
      ]
    },
    {
      "routeId": "gdd-requirements",
      "summary": "Extracts UI capability requirements with severity, scene/module mapping, and acceptance markers.",
      "requiredFields": [
        "capability_domain_ids",
        "acceptance_markers",
        "source_godot_ui_contract_hash"
      ]
    },
    {
      "routeId": "prototype-contract",
      "summary": "Freezes Godot UI capability contract version/hash into the prototype contract.",
      "requiredFields": [
        "godot_ui_contract_version",
        "source_godot_ui_contract_hash"
      ]
    },
    {
      "routeId": "iteration-plan",
      "summary": "Creates UI surface goals and required modules from P0/P1 capability requirements.",
      "requiredFields": [
        "capability_goal_refs",
        "semantic_reading_evidence"
      ]
    },
    {
      "routeId": "execute-next-goal",
      "summary": "Injects the frozen UI capability contract for relevant implementation goals.",
      "requiredFields": [
        "frozen_contract_ref",
        "required_capability_evidence"
      ]
    },
    {
      "routeId": "needs-fix",
      "summary": "Maps UI failures to requirement IDs and UI gap families.",
      "requiredFields": [
        "ui_gap_family",
        "requirement_ids"
      ]
    },
    {
      "routeId": "repair",
      "summary": "Keeps UI repair prompts bound to requirement IDs, diagnostics, and capability gaps.",
      "requiredFields": [
        "repair_ledger_ref",
        "ui_gap_family"
      ]
    },
    {
      "routeId": "ui-wiring-closure",
      "summary": "Validates the complete UI surface matrix, profiles, evidence, and exemptions.",
      "requiredFields": [
        "ui_surface_matrix",
        "profile_refs",
        "exemption_review"
      ]
    },
    {
      "routeId": "preview-package",
      "summary": "Exposes final-readiness blockers from UI closure without blocking early package generation.",
      "requiredFields": [
        "final_readiness_blockers",
        "ui_closure_ref"
      ]
    }
  ],
  "governanceRules": [
    {
      "ruleId": "visible_entry_feedback_required",
      "summary": "P0/P1 gameplay features need visible player entry, feedback, state boundary, and validation evidence unless no_ui_needed is explicitly reviewed.",
      "blocksP0P1": true
    },
    {
      "ruleId": "control_container_theme_preferred",
      "summary": "Prefer Control, Container, Theme, anchors, and safe areas; absolute positioning needs a fixed-format or world-overlay rationale.",
      "blocksP0P1": true
    },
    {
      "ruleId": "hud_menu_canvaslayer_input_owner",
      "summary": "HUD and menus must declare CanvasLayer/viewport ownership and input routing.",
      "blocksP0P1": true
    },
    {
      "ruleId": "drag_drop_state_complete",
      "summary": "Drag/drop and pointer-heavy features must declare start, hover, cancel, drop, invalid drop, and commit states.",
      "blocksP0P1": true
    },
    {
      "ruleId": "custom_drawing_evidence",
      "summary": "Custom drawing must declare drawing API, redraw trigger, hit-test strategy, and screenshot/canvas evidence.",
      "blocksP0P1": true
    },
    {
      "ruleId": "named_camera_physics_constants",
      "summary": "Camera/physics interactions must use named layers, masks, and measurable boundaries.",
      "blocksP0P1": true
    },
    {
      "ruleId": "approved_material_profiles",
      "summary": "Rendering/material/shader work must use approved Godot profiles or block with material_profile_missing.",
      "blocksP0P1": true
    },
    {
      "ruleId": "measured_size_required",
      "summary": "Size-sensitive work must cite AABB, get_aabb(), collision shape, import metadata, theme metric, or min-size source.",
      "blocksP0P1": true
    },
    {
      "ruleId": "godot_geometry_fallback",
      "summary": "Missing built-in geometry must use Godot geometry APIs with validation evidence.",
      "blocksP0P1": true
    },
    {
      "ruleId": "typed_state_required",
      "summary": "UI mode, animation state, input state, route state, and validation status must use enums, named constants, or schema enums.",
      "blocksP0P1": true
    },
    {
      "ruleId": "procedural_generation_replayable",
      "summary": "Procedural UI/world generation must be seedable, replayable, and validated.",
      "blocksP0P1": false
    },
    {
      "ruleId": "visual_evidence_required",
      "summary": "High-risk visual UI changes require screenshot, canvas-pixel, or exported visual evidence.",
      "blocksP0P1": false
    },
    {
      "ruleId": "material_profile_selected",
      "summary": "Pure-color/no-texture material work must select a known material profile or block.",
      "blocksP0P1": true
    },
    {
      "ruleId": "dynamic_ui_update_owner",
      "summary": "Dynamic UI must declare construction owner and update ownership mode.",
      "blocksP0P1": true
    },
    {
      "ruleId": "third_person_camera_shared_rig",
      "summary": "Third-person camera behavior must use or create the repo-owned shared rig/profile before gameplay-specific camera work.",
      "blocksP0P1": true
    },
    {
      "ruleId": "rendering_profile_selected",
      "summary": "Lighting, fog, sky, environment, and postprocess work must select a rendering/atmosphere profile with readability evidence.",
      "blocksP0P1": true
    },
    {
      "ruleId": "animation_profile_selected",
      "summary": "Character animation/state-machine work must select an animation profile with typed state and fallback behavior.",
      "blocksP0P1": true
    }
  ]
}
